{
	"name": "@mercuryworkshop/scramjet",
	"version": "2.0.67-alpha.1",
	"license": "AGPL-3.0-only",
	"description": "An experimental web proxy that aims to be the successor to Ultraviolet",
	"type": "module",
	"types": "./dist/types/index.d.ts",
	"main": "./dist/scramjet-external.mjs",
	"module": "./dist/scramjet-external.mjs",
	"repository": {
		"type": "git",
		"url": "https://github.com/MercuryWorkshop/scramjet"
	},
	"scripts": {
		"build": "cd ../.. && rspack build --mode production",
		"rewriter:build": "cd rewriter/wasm/ && bash build.sh && cd ../../",
		"dev": "node server.js",
		"dev:debug": "DEBUG=1 node server.js",
		"prepack": "RELEASE=1 npm run rewriter:build && npm run build",
		"format": "prettier --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix",
		"test": "npm run test:package",
		"test:package": "ava tests/ci/packageValidation.js",
		"preinstall": "npx only-allow pnpm"
	},
	"exports": {
		".": {
			"types": "./dist/types/typesEntry.d.ts",
			"default": "./dist/scramjet-external.mjs"
		},
		"./path": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.cjs"
		},
		"./bundled": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/scramjet.mjs"
		},
		"./bundled-wasm": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/scramjet_bundled.mjs"
		}
	},
	"files": [
		"dist",
		"lib"
	],
	"keywords": [],
	"author": "",
	"ava": {
		"files": [
			"tests/ci/**/*.js"
		],
		"verbose": true
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.35.0",
		"@types/eslint": "^9.6.1",
		"@types/estree": "^1.0.8",
		"@types/node": "^24.3.1",
		"@types/serviceworker": "^0.0.197",
		"@typescript-eslint/eslint-plugin": "8.60.0",
		"@typescript-eslint/parser": "8.60.0",
		"ava": "^6.4.1",
		"eslint": "^10.1.0",
		"prettier": "^3.6.2",
		"ts-checker-rspack-plugin": "^1.1.5",
		"tsc-alias": "^1.8.16",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@mercuryworkshop/proxy-transports": "catalog:",
		"dom-serializer": "^2.0.0",
		"domhandler": "^5.0.3",
		"domutils": "^3.2.2",
		"htmlparser2": "catalog:"
	}
}
