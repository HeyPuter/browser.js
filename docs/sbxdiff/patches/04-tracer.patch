+namespace {
+// Set once, on the main thread, before any document exists.
+base::TimeTicks g_virtual_time_base;
+}  // namespace
+
+void SetVirtualTimeBase(base::TimeTicks base) {
+  g_virtual_time_base = base;
+}
+
+base::TimeTicks GetVirtualTimeBase() {
+  return g_virtual_time_base;
+}
+
+namespace {
+
+// "<origin>,<prefix>" from --sbxdiff-shim-scripts, split once.
+const std::pair<std::string, std::string>& ShimScriptMarkers() {
+  static const base::NoDestructor<std::pair<std::string, std::string>> markers(
+      [] {
+        const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+        std::string v =
+            cmd ? cmd->GetSwitchValueASCII(::switches::kSbxdiffShimScripts)
+                : std::string();
+        const size_t comma = v.find(',');
+        if (comma == std::string::npos) {
+          return std::pair<std::string, std::string>();
+        }
+        return std::pair<std::string, std::string>(v.substr(0, comma),
+                                                   v.substr(comma + 1));
+      }());
+  return *markers;
+}
+
+}  // namespace
+
+namespace {
+
+// script id -> "this script is the shim's", per isolate.
+//
+// Leaked on purpose. Chromium builds with -Wexit-time-destructors and a
+// non-trivially-destructible thread_local trips it -- the same reason
+// PendingRealm above is a POD buffer rather than a std::string.
+std::map<uint32_t, bool>& ShimScriptCache() {
+  static thread_local std::map<uint32_t, bool>* cache =
+      new std::map<uint32_t, bool>();
+  return *cache;
+}
+
+std::string Utf8Of(v8::Isolate* isolate, v8::Local<v8::String> name) {
+  std::string url;
+  if (name.IsEmpty()) {
+    return url;
+  }
+  const size_t len = name->Utf8Length(isolate);
+  if (len > 0 && len <= kMaxStringBytes) {
+    std::vector<char> buf(len);
+    const size_t written = name->WriteUtf8(isolate, buf.data(), buf.size());
+    url.assign(buf.data(), written);
+  }
+  return url;
+}
+
+// On the proxy's origin, but NOT behind its prefix: that is the shim itself.
+// A guest script is on the same origin and does carry the prefix, which is
+// what makes these separable at all.
+bool UrlIsShim(const std::string& url) {
+  const auto& markers = ShimScriptMarkers();
+  return url.rfind(markers.first, 0) == 0 &&
+         url.find(markers.second) == std::string::npos;
+}
+
+// The browser's own UI, which is not the page on either side.
+//
+// It has timers -- chrome://webui-toolbar.top-chrome/app.js schedules two of
+// 50 ms each -- and once the logical clock became one counter for the whole
+// run (RULES.md #104) those started advancing the PAGE's clock. Measured as a
+// constant 50 ms offset between the two sides at the first poll round, before
+// the challenge script had run a line.
+bool UrlIsBrowserUi(const std::string& url) {
+  return url.rfind("chrome://", 0) == 0 ||
+         url.rfind("chrome-untrusted://", 0) == 0 ||
+         url.rfind("devtools://", 0) == 0 ||
+         url.rfind("chrome-extension://", 0) == 0;
+}
+
+// "This code is not the guest's", for deciding whose time is passing.
+//
+// Wider than UrlIsShim in one direction and narrower in another: the browser's
+// UI is never the guest even when no shim markers are configured, which is the
+// oracle, and that asymmetry is the point -- excluding it on one side only
+// would create exactly the divergence it is there to remove.
+bool IsNotGuest(const std::string& url) {
+  if (UrlIsBrowserUi(url)) {
+    return true;
+  }
+  if (ShimScriptMarkers().first.empty()) {
+    return false;
+  }
+  return UrlIsShim(url);
+}
+
+// Separate from ShimScriptCache because the predicate is different; both are
+// keyed on the script id V8 already assigns.
+std::map<uint32_t, bool>& NotGuestCache() {
+  static thread_local std::map<uint32_t, bool>* cache =
+      new std::map<uint32_t, bool>();
+  return *cache;
+}
+
+// How far down to look for a guest frame.
+//
+// Deep enough to see through a proxy's trap machinery, which is a handful of
+// frames, and bounded because this runs on every setTimeout and V8 has to
+// materialise every frame it is asked for.
+constexpr int kGuestFrameSearchDepth = 24;
+
+}  // namespace
+
+bool CurrentScriptIsShim(v8::Isolate* isolate) {
+  const auto& markers = ShimScriptMarkers();
+  if (markers.first.empty() || !isolate) {
+    return false;
+  }
+  const int id = v8::StackTrace::CurrentScriptId(isolate);
+  if (id <= 0) {
+    // No JS on the stack, so nothing to attribute. Not the shim.
+    return false;
+  }
+  // Per isolate, and keyed on the script id V8 already assigns, so the URL is
+  // resolved once per script rather than once per call.
+  auto& cache = ShimScriptCache();
+  const uint32_t script_id = static_cast<uint32_t>(id);
+  const auto it = cache.find(script_id);
+  if (it != cache.end()) {
+    return it->second;
+  }
+  const bool is_shim =
+      UrlIsShim(Utf8Of(isolate, v8::StackTrace::CurrentScriptNameOrSourceURL(
+                                    isolate)));
+  cache.emplace(script_id, is_shim);
+  return is_shim;
+}
+
+namespace {
+
+// The function actually behind a callback: past any Proxy, past any bind.
+//
+// A `setTimeout` trap forwards the page's function, but a function does not
+// have to carry a script. `Function.prototype.bind` produces one with
+// `ScriptId() <= 0` and no script origin, and so does a Proxy. Measured on rym
+// after the script-name test was in place, the two sides agreed EXACTLY on
+// every named script -- 29 gtag, 11 gtag, 8 challenge, 5 cdn-cgi, 4 turnstile,
+// 2 bundle.js, 1 page, on both -- and disagreed only on the scriptless ones:
+// 48 in the oracle against 58 in the sandbox. Those ten were the whole
+// remaining difference, and every one of them fell back to the stack and was
+// counted as the guest's without being looked at.
+//
+// Bounded: bind of a proxy of a bind is legal, a cycle is not, and the bound
+// costs nothing while a hang here would cost the run.
+v8::Local<v8::Value> UnwrapCallback(v8::Local<v8::Value> value) {
+  for (int i = 0; i < 8 && !value.IsEmpty(); ++i) {
+    if (value->IsProxy()) {
+      v8::Local<v8::Proxy> proxy = value.As<v8::Proxy>();
+      if (proxy->IsRevoked()) {
+        break;
+      }
+      value = proxy->GetTarget();
+      continue;
+    }
+    if (value->IsFunction()) {
+      const v8::Local<v8::Value> bound =
+          value.As<v8::Function>()->GetBoundFunction();
+      // Undefined for a function that is not bound, which is the exit.
+      if (!bound.IsEmpty() && bound->IsFunction() && bound != value) {
+        value = bound;
+        continue;
+      }
+    }
+    break;
+  }
+  return value;
+}
+
+}  // namespace
+
+std::string CallbackScriptUrl(v8::Isolate* isolate,
+                              v8::Local<v8::Value> callback) {
+  if (!isolate || callback.IsEmpty() || !callback->IsFunction()) {
+    return "(none)";
+  }
+  v8::HandleScope scope(isolate);
+  const v8::Local<v8::Value> target = UnwrapCallback(callback);
+  if (target.IsEmpty() || !target->IsFunction()) {
+    return "(not-a-function)";
+  }
+  v8::Local<v8::Function> fn = target.As<v8::Function>();
+  v8::Local<v8::Value> name = fn->GetScriptOrigin().ResourceName();
+  if (name.IsEmpty() || !name->IsString()) {
+    return "(no-script)";
+  }
+  const std::string url = Utf8Of(isolate, name.As<v8::String>());
+  return url.empty() ? "(empty)" : url;
+}
+
+int ClassifyCallback(v8::Isolate* isolate, v8::Local<v8::Value> callback) {
+  if (!isolate) {
+    return 0;
+  }
+  if (callback.IsEmpty() || !callback->IsFunction()) {
+    return -1;
+  }
+  v8::HandleScope scope(isolate);
+  const v8::Local<v8::Value> target = UnwrapCallback(callback);
+  if (target.IsEmpty() || !target->IsFunction()) {
+    return -1;
+  }
+  v8::Local<v8::Function> fn = target.As<v8::Function>();
+  const int id = fn->ScriptId();
+  if (id <= 0) {
+    // A built-in, or a function V8 has no script for.
+    return -1;
+  }
+  auto& cache = NotGuestCache();
+  const uint32_t script_id = static_cast<uint32_t>(id);
+  const auto it = cache.find(script_id);
+  if (it != cache.end()) {
+    return it->second ? 1 : 0;
+  }
+  std::string url;
+  v8::Local<v8::Value> name = fn->GetScriptOrigin().ResourceName();
+  if (!name.IsEmpty() && name->IsString()) {
+    url = Utf8Of(isolate, name.As<v8::String>());
+  }
+  const bool not_guest = IsNotGuest(url);
+  cache.emplace(script_id, not_guest);
+  return not_guest ? 1 : 0;
+}
+
+int GuestFrameDepth(v8::Isolate* isolate) {
+  if (!isolate) {
+    return 0;
+  }
+  v8::HandleScope scope(isolate);
+  // Default options, not kScriptNameOrSourceURL: the options are documented as
+  // deprecated and ignored today, and asking for one field would be a promise
+  // to break `GetScriptId()` the day they start being honoured again.
+  v8::Local<v8::StackTrace> stack =
+      v8::StackTrace::CurrentStackTrace(isolate, kGuestFrameSearchDepth);
+  if (stack.IsEmpty() || stack->GetFrameCount() == 0) {
+    // No JS on the stack: the browser itself scheduled this, and the oracle
+    // counts the same thing. Treating it as the shim's would make the two
+    // sides disagree about a timer neither page asked for.
+    return 0;
+  }
+  auto& cache = NotGuestCache();
+  for (int i = 0; i < stack->GetFrameCount(); ++i) {
+    v8::Local<v8::StackFrame> frame =
+        stack->GetFrame(isolate, static_cast<uint32_t>(i));
+    if (frame.IsEmpty()) {
+      continue;
+    }
+    const int id = frame->GetScriptId();
+    if (id <= 0) {
+      continue;
+    }
+    const uint32_t script_id = static_cast<uint32_t>(id);
+    const auto it = cache.find(script_id);
+    bool not_guest;
+    if (it != cache.end()) {
+      not_guest = it->second;
+    } else {
+      not_guest = IsNotGuest(Utf8Of(isolate, frame->GetScriptNameOrSourceURL()));
+      cache.emplace(script_id, not_guest);
+    }
+    if (!not_guest) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+int64_t ObservableStepUs() {
+  // 0 means off, so a build with nothing set behaves exactly as Chromium does.
+  static const int64_t us = [] {
+    const char* v = ::getenv("SBXDIFF_OBSERVABLE_STEP_US");
+    if (!v || !*v) {
+      return int64_t{0};
+    }
+    int64_t parsed = 0;
+    for (std::string_view digits(v); char c : digits) {
+      if (c < '0' || c > '9' || parsed > (1LL << 40)) {
+        return int64_t{0};
+      }
+      parsed = parsed * 10 + (c - '0');
+    }
+    return parsed;
+  }();
+  return us;
+}
+
+base::TimeTicks DeterministicEventTimeStamp(
+    base::TimeTicks platform_time_stamp) {
+  const base::TimeTicks base_ticks = g_virtual_time_base;
+  if (base_ticks.is_null() || platform_time_stamp.is_null()) {
+    return platform_time_stamp;
+  }
+  // WHICH CLOCK stamped this? An event the page made itself is stamped by
+  // TimeTicks::Now(), which virtual time overrides, so it lands near the
+  // VIRTUAL now. An input event is stamped in the browser process, outside the
+  // override, so it lands near the REAL now. Virtual time compresses the run --
+  // a 50 s journey can take 600 s of virtual clock -- so the two are far apart
+  // and whichever the stamp is nearer to is the clock it came from.
+  //
+  // An earlier version asked whether the stamp was in the FUTURE relative to
+  // TimeTicks::Now(). That was backwards: a fast-forwarding virtual clock puts
+  // every real stamp in the past, so the test never fired and `Event.timeStamp`
+  // went on diverging (558 against 563.5 across two oracle runs).
+  const base::TimeDelta from_virtual =
+      (platform_time_stamp - base::TimeTicks::Now()).magnitude();
+  const base::TimeDelta from_real =
+      (platform_time_stamp - base::subtle::TimeTicksNowIgnoringOverride())
+          .magnitude();
+  if (from_virtual <= from_real) {
+    // Virtual already, so it reproduces. Leave it exactly alone.
+    return platform_time_stamp;
+  }
+  // From the real clock: give it a slot on a 16 ms cadence -- reproducible, and
+  // the shape a real input stream has. Keyed on the RAW stamp so that events
+  // the platform stamped together stay together, which is what a browser does
+  // and what a page comparing two events' timestamps expects.
+  static base::TimeTicks last_raw;
+  static int64_t n = 0;
+  if (platform_time_stamp != last_raw) {
+    last_raw = platform_time_stamp;
+    ++n;
+  }
+  return base_ticks + base::Milliseconds(16 * n);
+}
+
+double VirtualTimeOriginUnixMs() {
+  // Parsed once: this is read on every `performance.timeOrigin`.
+  static const double origin = [] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd || !cmd->HasSwitch(::switches::kSbxdiffInitialTime)) {
+      return 0.0;
+    }
+    int64_t unix_ms = 0;
+    if (!base::StringToInt64(
+            cmd->GetSwitchValueASCII(::switches::kSbxdiffInitialTime),
+            &unix_ms)) {
+      return 0.0;
+    }
+
+    return static_cast<double>(unix_ms);
+  }();
+
+  return origin;
+}
