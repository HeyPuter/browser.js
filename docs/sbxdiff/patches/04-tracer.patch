+
+namespace blink::sbxdiff {
+
+namespace {
+
+// Keep in sync with docs/sbxdiff/ARCHITECTURE.md "Trace format".
+constexpr char kMagic[4] = {'S', 'B', 'X', 'D'};
+constexpr uint32_t kFormatVersion = 4;  // 4: realm records carry a creation time
+constexpr size_t kFlushThreshold = 4 * 1024;
+
+// Strings are recorded verbatim up to this many UTF-8 bytes, then truncated
+// (the true length is always recorded). T0 leak detection has to match the host
+// origin and the "/~/sj/" proxy prefix inside guest-visible strings, so a hash
+// is not sufficient -- the bytes are the signal.
+constexpr size_t kMaxStringBytes = 512;
+
+bool g_enabled_computed = false;
+bool g_enabled = false;
+
+// Key for the per-object run-local id. A v8::Private with kInternal kind: not
+// merely non-enumerable but filtered out of every JS key operation, skips
+// cross-origin access checks, and on a Proxy is stored on the proxy itself
+
+}  // namespace
+
+namespace {
+
+// sbxdiff: bisection aid, --sbxdiff-debug-disable=<mask>. Lets one build test
+// several hypotheses about which part of the tracer perturbs the embedder.
+// Not part of the oracle; a traced run leaves this unset.
+enum DebugDisable : int {
+  kDisableBindingCalls = 1,
+  kDisableInterceptors = 2,
+  kDisableObjectIds = 4,
+  kDisableDomEncode = 8,
+  kDisableScopeWork = 16,
+  kDisableTraceFile = 32,   // open /dev/null instead of a real trace file
+  kDisablePendingRealm = 64,  // skip the deferred-realm thread_local write
+  kDisableAttribution = 128,  // skip script attribution (measures its cost)
+};
+
+int DebugDisableMask() {
+  static const int mask = [] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd || !cmd->HasSwitch(::switches::kSbxdiffDebugDisable)) {
+      return 0;
+    }
+    int parsed = 0;
+    std::ignore = base::StringToInt(
+        cmd->GetSwitchValueASCII(::switches::kSbxdiffDebugDisable), &parsed);
+    return parsed;
+  }();
+  return mask;
+}
+
+}  // namespace
+
+// static
+bool SbxTracer::ScopeWorkDisabled() {
+  return (DebugDisableMask() & kDisableScopeWork) != 0;
+}
+
+// static
+bool SbxTracer::IsEnabled() {
+  if (!g_enabled_computed) {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    g_enabled = cmd && cmd->HasSwitch(switches::kSbxdiffTraceOut);
+    g_enabled_computed = true;
+  }
+  return g_enabled;
+}
+
+namespace {
+
+// Realm URL recorded before this thread had a tracer. Deliberately a POD
+// buffer rather than a thread_local std::string: Chromium builds with
+// -Wexit-time-destructors, and a non-trivially-destructible thread_local trips
+// it. Truncation is acceptable -- the tracer already truncates strings.
+// No default member initializers: those make the type non-trivially
+// constructible, which trips -Wglobal-constructors. A thread_local of trivial
+// type is zero-initialized.
+struct PendingRealm {
+  size_t len;
+  std::array<char, 2048> url;
+};
+thread_local PendingRealm g_pending_realm;
+
+// unique_ptr, not a raw pointer: ThreadSpecific destroys the *value* on
+// thread exit, so this is what makes ~SbxTracer (and its final Flush) run.
+// With a raw pointer the buffered tail was silently dropped -- which is why
+// the first working run produced header-only 10-byte trace files.
+ThreadSpecific<std::unique_ptr<SbxTracer>>& TracerSlot() {
+  DEFINE_THREAD_SAFE_STATIC_LOCAL(ThreadSpecific<std::unique_ptr<SbxTracer>>,
+                                  tracer, ());
+  return tracer;
+}
+
+}  // namespace
+
+// static
+SbxTracer* SbxTracer::GetIfExists() {
+  if (!IsEnabled()) {
+    return nullptr;
+  }
+  return TracerSlot()->get();
+}
+
+// static
+void SbxTracer::NoteRealmForContext(v8::Isolate* isolate,
+                                    v8::Local<v8::Object> global,
+                                    std::string_view url) {
+  if (!IsEnabled()) {
+    return;
+  }
+  if (SbxTracer* tracer = GetIfExists()) {
+    tracer->NoteRealm(isolate, global, url);
+    return;
+  }
+  if (DebugDisableMask() & kDisablePendingRealm) {
+    return;
+  }
+  const size_t len = std::min(url.size(), g_pending_realm.url.size());
+  g_pending_realm.len = len;
+  if (len > 0) {
+    std::ranges::copy(url.substr(0, len), g_pending_realm.url.begin());
+  }
+}
+
+// static
+SbxTracer* SbxTracer::Get() {
+  if (!IsEnabled()) {
+    return nullptr;
+  }
+  // Fast path: a plain POD thread_local, which is a direct TLS access.
+  //
+  // The slow path below goes through WTF::ThreadSpecific (pthread_getspecific
+  // plus WTF's own indirection), and this function runs on *every* binding
+  // call. Measured on 40k traced calls: going through ThreadSpecific each time
+  // cost ~10ms (13.2ms vs 3.3ms baseline) even with every record disabled --
+  // i.e. the lookup, not the recording, was the entire overhead. That made the
+  // browser ~4x slow at DOM work, which is detectable by timing.
+  //
+  // `cached` may dangle after the owning ThreadSpecific destroys the tracer at
+  // thread exit, but nothing runs on a thread after that point.
+  static thread_local SbxTracer* cached = nullptr;
+  static thread_local bool cached_valid = false;
+  if (cached_valid) {
+    return cached;
+  }
+  ThreadSpecific<std::unique_ptr<SbxTracer>>& tracer = TracerSlot();
+  if (!*tracer) {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    base::FilePath dir = cmd->GetSwitchValuePath(switches::kSbxdiffTraceOut);
+    // pid + thread discriminator keeps concurrent writers from interleaving.
+    static std::atomic<int> thread_counter{0};
+    int n = thread_counter.fetch_add(1);
+    base::FilePath path =
+        (DebugDisableMask() & kDisableTraceFile)
+            ? base::FilePath(FILE_PATH_LITERAL("/dev/null"))
+            : dir.AppendASCII("trace." +
+                              base::NumberToString(base::GetCurrentProcId()) +
+                              "." + base::NumberToString(n) + ".sbxd");
+    base::File file(path, base::File::FLAG_CREATE_ALWAYS |
+                              base::File::FLAG_WRITE);
+    if (!file.IsValid()) {
+      // Disable rather than crash: a missing --no-sandbox is the usual cause.
+      // IsEnabled() is now false, so the fast path above is not reached.
+      g_enabled = false;
+      return nullptr;
+    }
+    // Provenance only: lets a reader confirm two traces came from the same
+    // run key. The key itself is an arbitrary string (base/rand_util_posix.cc
+    // hashes it to 256 bits), so record a stable digest instead of parsing an
+    // integer -- an earlier integer parse silently yielded 0 for any
+    // non-numeric key.
+    uint64_t run_key = 0;
+    if (cmd->HasSwitch(::switches::kSbxdiffRunKey)) {
+      const std::string value =
+          cmd->GetSwitchValueASCII(::switches::kSbxdiffRunKey);
+      run_key = base::PersistentHash(base::as_byte_span(value));
+    }
+    *tracer = std::make_unique<SbxTracer>(std::move(file), run_key);
+  }
+  cached = tracer->get();
+  cached_valid = true;
+  return cached;
+}
+
+SbxTracer::SbxTracer(base::File file, uint64_t run_key)
+    : file_(std::move(file)) {
+  buffer_.reserve(kFlushThreshold + 4096);
+  record_buf_.reserve(512);
+  PutBytes(base::as_byte_span(std::string_view(kMagic, sizeof(kMagic))));
+  PutVarint(kFormatVersion);
+  PutVarint(static_cast<uint64_t>(base::GetCurrentProcId()));
+  PutVarint(run_key);
+  Flush();
+}
+
+SbxTracer::~SbxTracer() {
+  Flush();
+}
+
+void SbxTracer::PutU8(uint8_t v) {
+  Sink().push_back(v);
+}
+
+void SbxTracer::PutVarint(uint64_t v) {
+  while (v >= 0x80) {
+    Sink().push_back(static_cast<uint8_t>(v) | 0x80);
+    v >>= 7;
+  }
+  Sink().push_back(static_cast<uint8_t>(v));
+}
+
+void SbxTracer::PutBytes(base::span<const uint8_t> data) {
+  Sink().Append(data.begin(), data.end());
+}
+
+void SbxTracer::Flush() {
+  if (buffer_.empty() || !file_.IsValid()) {
+    return;
+  }
+  std::ignore = file_.WriteAtCurrentPos(base::span(buffer_));
+  buffer_.Shrink(0);
+}
+
+void SbxTracer::MaybeFlush() {
+  // Flush on a size threshold, and additionally at every task boundary (see
+  // OnCallCompleted). Not per record.
+  //
+  // Per-record flushing was correct but unusable: one write() syscall per
+  // binding call made DOM operations ~17x slower than stock (73.3ms vs 5.2ms
+  // for 20k setAttribute/getAttribute pairs, 89k records). That is trivially
+  // detectable by timing, and it is what made Cloudflare Turnstile loop
+  // forever on rateyourmusic.com while the same build with tracing off passed.
+  //
+  // Plain size-threshold batching is what per-record flushing replaced,
+  // because it lost the tail *nondeterministically*: a renderer is usually torn
+  // down without running thread destructors, and three runs of one page gave
+  // 1591, 2352 and 2956 records. Truncation that moves with timing is fatal for
+  // a differential oracle.
+  //
+  // Flushing at task boundaries fixes both. Syscalls drop from per-record to
+  // per-task, and any truncation lands on a task boundary -- a deterministic
+  // point -- rather than mid-buffer. At most one task's records can be lost,
+  // and the differ already segments by task.
+  if (buffer_.size() >= kFlushThreshold) {
+    Flush();
+  }
+}
+
+uint32_t SbxTracer::CurrentScriptId(v8::Isolate* isolate) {
+  if (DebugDisableMask() & kDisableAttribution) {
+    return 0;
+  }
+  const int id = v8::StackTrace::CurrentScriptId(isolate);
+  if (id <= 0) {
+    // No JS on the stack: the binding was reached from C++ (parser-driven
+    // work, a platform callback). Recorded as 0 rather than omitted, so the
+    // differ can see that it happened rather than inferring it.
+    return 0;
+  }
+  const uint32_t script_id = static_cast<uint32_t>(id);
+  if (known_scripts_.Contains(script_id)) {
+    return script_id;
+  }
+  known_scripts_.insert(script_id);
+
+  // Resolve the URL once per script. This allocates a handle, which is why it
+  // is not on the per-record path.
+  std::string url;
+  v8::Local<v8::String> name =
+      v8::StackTrace::CurrentScriptNameOrSourceURL(isolate);
+  if (!name.IsEmpty()) {
+    const size_t len = name->Utf8Length(isolate);
+    if (len > 0 && len <= kMaxStringBytes) {
+      std::vector<char> buf(len);
+      const size_t written =
+          name->WriteUtf8(isolate, buf.data(), buf.size());
+      url.assign(buf.data(), written);
+    }
+  }
+
+  // Emit into buffer_, never into a record under construction, so the mapping
+  // precedes the record that references it (same rule as InternLiteral).
+  bool saved = building_record_;
+  building_record_ = false;
+  PutVarint(static_cast<uint64_t>(RecordKind::kScript));
+  PutVarint(script_id);
+  PutVarint(url.size());
+  if (!url.empty()) {
+    PutBytes(base::as_byte_span(url));
+  }
+  building_record_ = saved;
+  return script_id;
+}
+
+uint32_t SbxTracer::InternLiteral(const char* literal) {
+  // Keyed on the pointer: bind_gen always passes a string literal, so pointer
+  // identity is sound and makes this a single hash lookup on the hot path.
+  auto it = interned_.find(literal);
+  if (it != interned_.end()) {
+    return it->value;
+  }
+  uint32_t id = next_intern_id_++;
+  interned_.insert(literal, id);
+
+  // Always emit into buffer_, never into a record under construction, so the
+  // intern record precedes the record that references it.
+  bool saved = building_record_;
+  building_record_ = false;
+  std::string_view name(literal);
+  PutVarint(static_cast<uint64_t>(RecordKind::kIntern));
+  PutVarint(id);
+  PutVarint(name.size());
+  PutBytes(base::as_byte_span(name));
+  building_record_ = saved;
+  return id;
+}
+
+uint64_t SbxTracer::ObjectIdFor(v8::Isolate* isolate,
+                                v8::Local<v8::Object> object) {
+  if (DebugDisableMask() & kDisableObjectIds) {
+    return next_object_id_++;
+  }
+  if (!isolate->InContext()) {
+    return 0;
+  }
+  // Identity WITHOUT touching the page's object.
+  //
+  // This used to stash the id in a v8::Private on the object itself. Private
+  // symbols are invisible to every reflection path -- Object.keys, proxies,
+  // cross-origin checks, all verified -- but "invisible to reflection" is not
+  // "no observable effect": adding a property forces a hidden-class
+  // transition, which can turn a monomorphic inline cache megamorphic for code
+  // touching that object. A page can detect that by timing operations on its
+  // *own* objects without ever seeing the property.
+  //
+  // Measured on rateyourmusic.com: full tracing looped the Cloudflare
+  // challenge forever; disabling only the private-property write (mask=4) made
+  // it pass, as did disabling recording entirely. Aggregate overhead was ~14ms
+  // across seconds of challenge work, far too little for a timing check -- so
+  // the signal was structural, not temporal.
+  //
+  // A DOM wrapper already carries a stable identity: the Blink object behind
+  // it. Reading it mutates nothing.
+  if (V8DOMWrapper::IsWrapper(isolate, object)) {
+    if (ScriptWrappable* wrappable = ToAnyScriptWrappable(isolate, object)) {
+      const void* key = static_cast<const void*>(wrappable);
+      auto it = wrappable_ids_.find(key);
+      if (it != wrappable_ids_.end()) {
+        return it->value;
+      }
+      const uint64_t id = next_object_id_++;
+      wrappable_ids_.Set(key, id);
+      return id;
+    }
+  }
+  // Non-wrapper objects (plain JS objects, functions, proxies) get no stable
+  // id. Giving them one would mean either mutating them or holding weak
+  // handles; the differ can still pair them positionally by seq. Recorded as
+  // 0 = "unidentified" so this is visible rather than silently aliased.
+  return 0;
+}
+
+uint64_t SbxTracer::CurrentRealmId(v8::Isolate* isolate) {
+  if (!isolate->InContext()) {
+    return 0;
+  }
+  // Global() is the global *proxy*, which is stable for the realm's lifetime.
+  return ObjectIdFor(isolate, isolate->GetCurrentContext()->Global());
+}
+
+// static
+void SbxTracer::OnBeforeCallEntered(v8::Isolate*) {
+  // Thread-specific, so this resolves to the tracer for the thread whose
+  // isolate just entered JS.
+  if (SbxTracer* tracer = SbxTracer::Get()) {
+    if (!tracer->in_js_) {
+      tracer->in_js_ = true;
+      tracer->current_task_id_ = ++tracer->next_task_id_;
+      // Must be cleared wherever the task id changes, not just in
+      // EnsureTaskOpen: a stale entry script would attribute this task's work
+      // to whoever entered the previous one.
+      tracer->current_entry_script_ = 0;
+    }
+  }
+}
+
+// static
+void SbxTracer::OnCallCompleted(v8::Isolate*) {
+  // Fires only for the outermost JS execution, and only after V8 has drained
+  // the microtask checkpoint, so everything the task caused is already
+  // recorded under current_task_id_.
+  if (SbxTracer* tracer = SbxTracer::Get()) {
+    tracer->in_js_ = false;
+    tracer->current_task_id_ = 0;
+    tracer->current_entry_script_ = 0;
+    // Task boundary: a deterministic place to flush, so truncation can only
+    // ever land here rather than at an arbitrary point inside a task.
+    tracer->Flush();
+  }
+}
+
+// static
+bool SbxTracer::ShouldBlockRequest(std::string_view url) {
+  // Parsed once. An empty optional means the switch is absent, in which case
+  // the gate is inert -- a traced run without --sbxdiff-net-allow behaves
+  // exactly as before.
+  // NoDestructor: a static std::set has an exit-time destructor, which is
+  // -Werror here.
+  static base::NoDestructor<std::optional<std::set<std::string>>> allow([] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd || !cmd->HasSwitch(::switches::kSbxdiffNetAllow)) {
+      return std::optional<std::set<std::string>>();
+    }
+    std::set<std::string> urls;
+    std::string contents;
+    if (base::ReadFileToString(
+            cmd->GetSwitchValuePath(::switches::kSbxdiffNetAllow), &contents)) {
+      for (std::string_view line : base::SplitStringPiece(
+               contents, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+        urls.emplace(line);
+      }
+    }
+    return std::optional<std::set<std::string>>(std::move(urls));
+  }());
+  if (!allow->has_value()) {
+    return false;
+  }
+  return !(*allow)->contains(std::string(url));
+}
+
+void SbxTracer::TraceNetRequest(std::string_view method,
+                                std::string_view url,
+                                bool blocked) {
+  // No isolate here: resource loads are not necessarily inside a v8 context,
+  // so this record carries the task id (thread-local, always available) but no
+  // realm id. Ordering against binding records comes from seq.
+  record_buf_.Shrink(0);
+  building_record_ = true;
+  PutVarint(static_cast<uint64_t>(RecordKind::kNetRequest));
+  PutVarint(seq_++);
+  PutVarint(CurrentTaskId());
+  PutU8(blocked ? 1 : 0);
+  PutVarint(method.size());
+  PutBytes(base::as_byte_span(method));
+  PutVarint(url.size());
+  PutBytes(base::as_byte_span(url));
+  building_record_ = false;
+  buffer_.Append(record_buf_.begin(), record_buf_.end());
+  ++records_written_;
+  Flush();
+}
+
+void SbxTracer::TraceException(int exception_code, std::string_view message) {
+  record_buf_.Shrink(0);
+  building_record_ = true;
+  PutVarint(static_cast<uint64_t>(RecordKind::kException));
+  PutVarint(seq_++);
+  PutVarint(CurrentTaskId());
+  PutVarint(static_cast<uint64_t>(exception_code));
+  const size_t emit = std::min(message.size(), kMaxStringBytes);
+  PutVarint(message.size());
+  PutVarint(emit);
+  if (emit > 0) {
+    PutBytes(base::as_byte_span(message.substr(0, emit)));
+  }
+  building_record_ = false;
+  buffer_.Append(record_buf_.begin(), record_buf_.end());
+  ++records_written_;
+  MaybeFlush();
+}
+
+void SbxTracer::FlushPendingRealm(v8::Isolate* isolate) {
+  if (g_pending_realm.len == 0) {
+    return;
+  }
+  const std::string url(g_pending_realm.url.data(), g_pending_realm.len);
+  // Clear first: NoteRealm must not be able to re-enter this.
+  g_pending_realm.len = 0;
+  if (!isolate->InContext()) {
+    return;
+  }
+  NoteRealm(isolate, isolate->GetCurrentContext()->Global(), url);
+}
+
+void SbxTracer::EnsureTaskOpen() {
+  if (current_task_id_ == 0) {
+    current_task_id_ = ++next_task_id_;
+    // Captured once per task rather than per record: the script that entered
+    // the task is what says *whose* work this is, and it cannot change within
+    // the task.
+    current_entry_script_ = 0;
+  }
+}
+
+void SbxTracer::EnsureIsolateHooks(v8::Isolate* isolate) {
+  if (isolate_hooked_ || !isolate) {
+    return;
+  }
+  isolate_hooked_ = true;
+  isolate->AddBeforeCallEnteredCallback(&SbxTracer::OnBeforeCallEntered);
+  isolate->AddCallCompletedCallback(&SbxTracer::OnCallCompleted);
+}
+
+void SbxTracer::NoteRealm(v8::Isolate* isolate,
+                          v8::Local<v8::Object> global,
+                          std::string_view url) {
+#if DCHECK_IS_ON()
+  v8::Isolate::DisallowJavascriptExecutionScope no_js(
+      isolate, v8::Isolate::DisallowJavascriptExecutionScope::CRASH_ON_FAILURE);
+#endif
+  uint64_t realm_id = ObjectIdFor(isolate, global);
+  record_buf_.Shrink(0);
+  building_record_ = true;
+  PutVarint(static_cast<uint64_t>(RecordKind::kRealm));
+  PutVarint(seq_++);
+  PutVarint(realm_id);
+  PutVarint(url.size());
+  PutBytes(base::as_byte_span(url));
+  // When this realm was created, on a clock that is comparable ACROSS trace
+  // files -- which `seq` is not. seq counts records within one file, so two
+  // realms in different files both begin at 1, and the differ's rule for
+  // picking the document a run ended on ("latest first seq") is a coin flip
+  // between them. Measured on rateyourmusic: the oracle's two realms at
+  // https://rateyourmusic.com/ are in file 1 and file 16, both firstSeq=1, one
+  // with 2106 records and one with 7465.
+  //
+  // Deliberately the UNOVERRIDDEN clock: virtual time is per-process and would
+  // make the stamps incomparable between a page's renderer and a cross-origin
+  // subframe's, which is exactly the comparison this has to support.
+  PutVarint(static_cast<uint64_t>(
+      base::subtle::TimeTicksNowIgnoringOverride().since_origin()
+          .InMicroseconds()));
+  building_record_ = false;
+  buffer_.Append(record_buf_.begin(), record_buf_.end());
+  ++records_written_;
+  Flush();
+}
+
+void SbxTracer::EncodeValue(v8::Isolate* isolate, v8::Local<v8::Value> value) {
+  // Every branch below must be JS-free. Do not add ToString/Get/Has/
+  // GetOwnPropertyNames/GetOwnPropertyDescriptor/JSON::Stringify or
+  // GetPrototype here; see RULES.md #1.
+  if (value.IsEmpty() || value->IsUndefined()) {
+    PutU8(static_cast<uint8_t>(ValueTag::kUndefined));
+    return;
+  }
+  if (value->IsNull()) {
+    PutU8(static_cast<uint8_t>(ValueTag::kNull));
+    return;
+  }
+  if (value->IsBoolean()) {
+    PutU8(static_cast<uint8_t>(ValueTag::kBool));
+    PutU8(value->IsTrue() ? 1 : 0);
+    return;
+  }
+  if (value->IsNumber()) {
+    PutU8(static_cast<uint8_t>(ValueTag::kNumber));
+    // Raw IEEE-754 bits: exact, and distinguishes -0 from 0 and NaN payloads.
+    PutVarint(std::bit_cast<uint64_t>(value.As<v8::Number>()->Value()));
+    return;
+  }
+  if (value->IsString()) {
+    PutU8(static_cast<uint8_t>(ValueTag::kString));
+    v8::Local<v8::String> s = value.As<v8::String>();
+    // Utf8Length/WriteUtf8, not the V2 spellings: those are V8_DEPRECATE_SOON.
+    // Both only flatten the string; neither can run JS.
+    PutVarint(s->Utf8Length(isolate));
+    std::array<char, kMaxStringBytes> buf;
+    const size_t emit = s->WriteUtf8(isolate, buf.data(), buf.size());
+    PutVarint(emit);
+    if (emit > 0) {
+      // Via string_view so this stays span-based; Chromium builds with
+      // -Wunsafe-buffer-usage as an error, so no pointer arithmetic.
+      PutBytes(base::as_byte_span(std::string_view(buf.data(), emit)));
+    }
+    return;
+  }
+  if (value->IsBigInt()) {
+    PutU8(static_cast<uint8_t>(ValueTag::kBigInt));
+    return;
+  }
+  if (value->IsSymbol()) {
+    PutU8(static_cast<uint8_t>(ValueTag::kSymbol));
+    return;
+  }
+  if (value->IsProxy()) {
+    // Tag before IsObject: a Proxy is an object, and conflating them would
+    // hide exactly the wrapper scramjet hands the guest.
+    PutU8(static_cast<uint8_t>(ValueTag::kProxy));
+    PutVarint(ObjectIdFor(isolate, value.As<v8::Object>()));
+    return;
+  }
+  if (value->IsObject()) {
+    v8::Local<v8::Object> object = value.As<v8::Object>();
+    // ToWrapperTypeInfo is NOT a safe probe on an arbitrary object: it calls
+    // ToAnyWrappable, which reads the wrapper internal fields without first
+    // checking they exist, and faults (BUS_ADRALN) on an object that has none.
+    // A v8::Function is an Object, so this fired immediately on an
+    // ExposedConstruct getter (window.ShadowRoot returns an interface object).
+    // V8DOMWrapper::IsWrapper is the sanctioned guard -- see the comment on
+    // HasInternalFieldsSet in v8_dom_wrapper.h, which says to prefer it.
+    const WrapperTypeInfo* type_info =
+        (!(DebugDisableMask() & kDisableDomEncode) &&
+         V8DOMWrapper::IsWrapper(isolate, object))
+            ? ToWrapperTypeInfo(object)
+            : nullptr;
+    if (type_info) {
+      PutU8(static_cast<uint8_t>(ValueTag::kDomWrapper));
+      PutVarint(ObjectIdFor(isolate, object));
+      PutVarint(InternLiteral(type_info->interface_name));
+      return;
+    }
+    PutU8(static_cast<uint8_t>(value->IsFunction() ? ValueTag::kFunction
+                                                   : ValueTag::kObject));
+    PutVarint(ObjectIdFor(isolate, object));
+    return;
+  }
+  PutU8(static_cast<uint8_t>(ValueTag::kOpaque));
+}
+
+void SbxTracer::TraceBindingCall(const char* name,
+                                 v8::Isolate* isolate,
+                                 v8::Local<v8::Value> receiver,
+                                 v8::Local<v8::Value> result,
+                                 bool threw,
+                                 uint32_t argc_total,
+                                 base::span<const v8::Local<v8::Value>> args) {
+  // Mechanical proof that nothing below re-enters JS (RULES.md #1).
+#if DCHECK_IS_ON()
+  v8::Isolate::DisallowJavascriptExecutionScope no_js(
+      isolate, v8::Isolate::DisallowJavascriptExecutionScope::CRASH_ON_FAILURE);
+#endif
+  if (DebugDisableMask() & kDisableBindingCalls) {
+    return;
+  }
+  uint32_t name_id = InternLiteral(name);
+  // Before the record starts building -- this writes a record of its own.
+  FlushPendingRealm(isolate);
+
+  record_buf_.Shrink(0);
+  building_record_ = true;
+  PutVarint(static_cast<uint64_t>(RecordKind::kBindingCall));
+  PutU8(static_cast<uint8_t>(Level::kCompared));
+  PutVarint(seq_++);
+  PutVarint(CurrentRealmId(isolate));
+  EnsureIsolateHooks(isolate);
+  EnsureTaskOpen();
+  PutVarint(CurrentTaskId());
+  {
+    const uint32_t top = CurrentScriptId(isolate);
+    if (current_entry_script_ == 0) {
+      current_entry_script_ = top;
+    }
+    PutVarint(top);
+    PutVarint(current_entry_script_);
+  }
+  PutVarint(name_id);
+  PutU8(threw ? 1 : 0);
+  EncodeValue(isolate, receiver);
+  EncodeValue(isolate, result);
+  // Arguments last, so the rest of the record keeps its v1 layout. argc_total
+  // is the real count and args.size() what was emitted; they differ only when
+  // a call exceeds kMaxTracedArgs, and the differ needs to tell that from a
+  // genuinely shorter call.
+  PutVarint(argc_total);
+  PutVarint(args.size());
+  for (const v8::Local<v8::Value>& arg : args) {
+    EncodeValue(isolate, arg);
+  }
+  building_record_ = false;
+  buffer_.Append(record_buf_.begin(), record_buf_.end());
+
+  ++records_written_;
+  MaybeFlush();
+}
+
+void SbxTracer::TraceInterceptorNamed(const char* name,
+                                      v8::Isolate* isolate,
+                                      v8::Local<v8::Value> receiver,
+                                      v8::Local<v8::Value> key,
+                                      v8::Local<v8::Value> value) {
+#if DCHECK_IS_ON()
+  v8::Isolate::DisallowJavascriptExecutionScope no_js(
+      isolate, v8::Isolate::DisallowJavascriptExecutionScope::CRASH_ON_FAILURE);
+#endif
+  if (DebugDisableMask() & kDisableInterceptors) {
+    return;
+  }
+  uint32_t name_id = InternLiteral(name);
+  // Before the record starts building -- this writes a record of its own.
+  FlushPendingRealm(isolate);
+  record_buf_.Shrink(0);
+  building_record_ = true;
+  PutVarint(static_cast<uint64_t>(RecordKind::kInterceptor));
+  PutU8(static_cast<uint8_t>(Level::kCompared));
+  PutVarint(seq_++);
+  PutVarint(CurrentRealmId(isolate));
+  EnsureIsolateHooks(isolate);
+  EnsureTaskOpen();
+  PutVarint(CurrentTaskId());
+  {
+    const uint32_t top = CurrentScriptId(isolate);
+    if (current_entry_script_ == 0) {
+      current_entry_script_ = top;
+    }
+    PutVarint(top);
+    PutVarint(current_entry_script_);
+  }
+  PutVarint(name_id);
+  PutU8(0);  // key kind: 0 = name/value
+  EncodeValue(isolate, receiver);
+  EncodeValue(isolate, key);
+  // Setter/definer interceptors carry the value being written; reads do not.
+  // A flag rather than an always-present value, so read records stay the size
+  // they were -- interceptor reads are the highest-volume record kind.
+  PutU8(value.IsEmpty() ? 0 : 1);
+  if (!value.IsEmpty()) {
+    EncodeValue(isolate, value);
+  }
+  building_record_ = false;
+  buffer_.Append(record_buf_.begin(), record_buf_.end());
+  ++records_written_;
+  MaybeFlush();
+}
