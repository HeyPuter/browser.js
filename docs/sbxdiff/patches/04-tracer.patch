+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_INTERCEPT_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_INTERCEPT_H_
+
+#include "third_party/blink/renderer/platform/bindings/sbxdiff/sbx_tracer.h"
+#include "v8/include/v8-template.h"
+
+namespace blink::sbxdiff {
+
+#if BUILDFLAG(SBXDIFF)
+
+// Records whether an interceptor *declined*.
+//
+// `v8::Intercepted::kNo` means "I did not handle this; fall through to the
+// ordinary lookup", and it is guest-observable: a sandbox that declines where
+// Chromium intercepts resolves the property differently. But the outcome is a
+// return value, so the SbxInterceptorScope in the callback body -- which
+// records on entry -- cannot see it.
+//
+// The plan called for renaming every generated callback to `<name>Impl` and
+// emitting a thin public wrapper. This is cheaper and touches no callback
+// bodies: wrap at the *registration* site instead, where the function pointer
+// is handed to v8::NamedPropertyHandlerConfiguration. One class template with
+// two partial specializations covers all twelve Intercepted-returning
+// callbacks, because they all have the shape
+//
+//     Intercepted (*)(Key, [Extra,] const PropertyCallbackInfo<R>&)
+//
+// and the types are deduced from the function pointer. (The enumerator
+// callbacks return void and cannot decline, so they are left alone.)
+//
+// No name plumbing is needed: the body's own scope already wrote a record
+// carrying the interface + function name, and the outcome record refers back
+// to it by seq. The seq is sampled *before* the inner call, so an interceptor
+// that re-enters JS and triggers nested interceptors still attributes its own
+// outcome correctly -- nested records take higher seqs.
+template <auto Fn>
+struct SbxIntercept;
+
+// Getter / query / deleter / descriptor: (Key, Info).
+template <typename Key,
+          typename Info,
+          v8::Intercepted (*Fn)(Key, const Info&)>
+struct SbxIntercept<Fn> {
+  static v8::Intercepted Run(Key key, const Info& info) {
+    SbxTracer* tracer = SbxTracer::Get();
+    const uint64_t mark = tracer ? tracer->PeekSeq() : 0;
+    const v8::Intercepted result = Fn(key, info);
+    if (tracer) {
+      tracer->TraceInterceptorOutcome(
+          mark, result == v8::Intercepted::kYes);
+    }
+    return result;
+  }
+};
+
+// Setter / definer: (Key, Value-or-PropertyDescriptor, Info).
+template <typename Key,
+          typename Extra,
+          typename Info,
+          v8::Intercepted (*Fn)(Key, Extra, const Info&)>
+struct SbxIntercept<Fn> {
+  static v8::Intercepted Run(Key key, Extra extra, const Info& info) {
+    SbxTracer* tracer = SbxTracer::Get();
+    const uint64_t mark = tracer ? tracer->PeekSeq() : 0;
+    const v8::Intercepted result = Fn(key, extra, info);
+    if (tracer) {
+      tracer->TraceInterceptorOutcome(
+          mark, result == v8::Intercepted::kYes);
+    }
+    return result;
+  }
+};
+
+#endif  // BUILDFLAG(SBXDIFF)
+
+}  // namespace blink::sbxdiff
+
+#if BUILDFLAG(SBXDIFF)
+#define SBX_INTERCEPT(fn) (&::blink::sbxdiff::SbxIntercept<fn>::Run)
+#else
+#define SBX_INTERCEPT(fn) (fn)
+#endif
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_INTERCEPT_H_
diff --git a/third_party/blink/renderer/platform/bindings/sbxdiff/sbx_scope.h b/third_party/blink/renderer/platform/bindings/sbxdiff/sbx_scope.h
new file mode 100644
index 0000000000000..ec6b760ae282d
--- /dev/null
+++ b/third_party/blink/renderer/platform/bindings/sbxdiff/sbx_scope.h
@@ -0,0 +1,278 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// sbxdiff: the RAII scope that bind_gen's existing BLINK_BINDINGS_TRACE_EVENT
+// macro expands to when BUILDFLAG(SBXDIFF) is on.
+//
+// Why this needs no generator change: interface.py:842 already emits
+//   BLINK_BINDINGS_TRACE_EVENT("Iface.prop.get");
+// at the prologue of every generated attribute get/set, operation, constructor,
+// exposed construct, legacy factory function, overload dispatcher and
+// stringifier callback -- 1,152 of the 2,928 generated .cc files -- and `info`
+// is always in scope there, always named `info`, and always a
+// const v8::FunctionCallbackInfo<v8::Value>&. So redefining the macro reaches
+// chokepoint A in full.
+//
+// Interceptor callbacks (named/indexed property getters, i.e. window[name],
+// coll[i], coll["name"]) do NOT get this macro and are therefore NOT covered.
+// Verified empirically: 30 accesses each produced zero trace events. Those need
+// the second chokepoint, _make_interceptor_callback_def, which is a real
+// generator change. See docs/sbxdiff/PROGRESS.md (M1).
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_SCOPE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_SCOPE_H_
+
+#include <array>
+
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/platform/bindings/buildflags.h"
+
+#if BUILDFLAG(SBXDIFF)
+#include "third_party/blink/renderer/platform/bindings/sbxdiff/sbx_tracer.h"
+#endif
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+#include "v8/include/v8-function-callback.h"
+#include "v8/include/v8-object.h"
+#include "v8/include/v8-isolate.h"
+#include "v8/include/v8-local-handle.h"
+
+#if BUILDFLAG(SBXDIFF)
+
+namespace blink::sbxdiff {
+
+// bind_gen emits the macro into three distinct callback signatures, measured
+// across both generated trees:
+//   const v8::FunctionCallbackInfo<v8::Value>&    13418 sites
+//   const v8::PropertyCallbackInfo<v8::Value>&     2212 sites
+//   const v8::PropertyCallbackInfo<v8::Boolean>&      2 sites (cross-origin
+//                                                             Location setters)
+// always named `info`. The two info types expose *different* receiver
+// accessors -- FunctionCallbackInfo has This() and no Holder(), while
+// PropertyCallbackInfo has Holder() and no This() -- so the receiver is
+// selected by overload rather than assumed.
+//
+// FIDELITY CAVEAT: for PropertyCallbackInfo sites we therefore record Holder()
+// (the object the property was found on) rather than the receiver the guest
+// actually used. Those differ when the property is inherited or reached through
+// an interceptor. Revisit if V8 exposes This() on PropertyCallbackInfo.
+template <typename T>
+inline v8::Local<v8::Object> SbxReceiver(
+    const v8::FunctionCallbackInfo<T>& info) {
+  return info.This();
+}
+
+// Argument access, selected by overload for the same reason the receiver is.
+// FunctionCallbackInfo carries the JS arguments -- which for an attribute
+// setter is the value being written; PropertyCallbackInfo carries none.
+//
+// Without these the trace is blind to every value a page writes: a setter
+// records `-> undefined` and nothing else, so a sandbox setting
+// textContent='A' where Chromium sets 'B' produced a byte-identical trace.
+template <typename T>
+inline int SbxArgCount(const v8::FunctionCallbackInfo<T>& info) {
+  return info.Length();
+}
+template <typename T>
+inline int SbxArgCount(const v8::PropertyCallbackInfo<T>&) {
+  return 0;
+}
+
+template <typename T>
+inline v8::Local<v8::Value> SbxArgAt(const v8::FunctionCallbackInfo<T>& info,
+                                     int i) {
+  return info[i];
+}
+template <typename T>
+inline v8::Local<v8::Value> SbxArgAt(const v8::PropertyCallbackInfo<T>&, int) {
+  return v8::Local<v8::Value>();
+}
+
+// Arguments recorded per call. Capped rather than unbounded: this is the
+// change most likely to inflate trace size, and the true count is recorded
+// alongside so the differ can tell truncation from a short call.
+inline constexpr int kMaxTracedArgs = 8;
+
+template <typename T>
+inline v8::Local<v8::Object> SbxReceiver(
+    const v8::PropertyCallbackInfo<T>& info) {
+  return info.Holder();
+}
+
+// Records one generated binding callback: receiver identity on entry, and
+// return value plus exception state on exit.
+//
+// The return value can only be read on destruction, because the generated
+// prologue runs before bindings::V8SetReturnValue. v8::ReturnValue<T>::Get()
+// yields undefined when nothing was set, which is the correct encoding for a
+// void operation, and neither it nor HasPendingException can execute JS.
+template <typename InfoType>
+class SbxBindingScope {
+  STACK_ALLOCATED();
+
+ public:
+  SbxBindingScope(const char* name, const InfoType& info)
+      : tracer_(SbxTracer::Get()), name_(name), info_(&info) {}
+
+  SbxBindingScope(const SbxBindingScope&) = delete;
+  SbxBindingScope& operator=(const SbxBindingScope&) = delete;
+
+  ~SbxBindingScope() {
+    if (!tracer_ || SbxTracer::ScopeWorkDisabled()) {
+      return;
+    }
+    v8::Isolate* isolate = info_->GetIsolate();
+    const int argc_total = SbxArgCount(*info_);
+    const int argc = argc_total < kMaxTracedArgs ? argc_total : kMaxTracedArgs;
+    std::array<v8::Local<v8::Value>, kMaxTracedArgs> argv;
+    for (int i = 0; i < argc; ++i) {
+      argv[i] = SbxArgAt(*info_, i);
+    }
+    // Instrumenting the prologue means every early return in the generated body
+    // -- the four attribute-setter fast paths and the
+    // make_return_value_cache_return_early path -- still lands here.
+    tracer_->TraceBindingCall(
+        name_, isolate, SbxReceiver(*info_), info_->GetReturnValue().Get(),
+        isolate->HasPendingException(), static_cast<uint32_t>(argc_total),
+        base::span<const v8::Local<v8::Value>>(argv).first(
+            static_cast<size_t>(argc)));
+  }
+
+ private:
+  SbxTracer* tracer_;
+  const char* name_;
+  const InfoType* info_;
+};
+
+// Records one interceptor callback on entry. Separate from SbxBindingScope
+// because interceptors cannot report an outcome from a destructor: they return
+// v8::Intercepted (a decline is guest-observable but invisible to a destructor),
+// and the IndexOf variant takes PropertyCallbackInfo<void>, which has no usable
+// return value at all. Recording happens in the constructor, so nothing here
+// depends on the info's template parameter beyond GetIsolate()/Holder().
+template <typename InfoType>
+class SbxInterceptorScope {
+  STACK_ALLOCATED();
+
+ public:
+  // Named property interceptors: key is a v8::Name.
+  SbxInterceptorScope(const char* name,
+                      v8::Local<v8::Name> key,
+                      const InfoType& info) {
+    if (SbxTracer::ScopeWorkDisabled()) {
+      return;
+    }
+    if (SbxTracer* tracer = SbxTracer::Get()) {
+      tracer->TraceInterceptorNamed(name, info.GetIsolate(),
+                                    SbxReceiver(info), key);
+    }
+  }
+
+  // Indexed property interceptors.
+  SbxInterceptorScope(const char* name, uint32_t index, const InfoType& info) {
+    if (SbxTracer::ScopeWorkDisabled()) {
+      return;
+    }
+    if (SbxTracer* tracer = SbxTracer::Get()) {
+      tracer->TraceInterceptorIndexed(name, info.GetIsolate(),
+                                      SbxReceiver(info), index);
+    }
+  }
+
+  // Named setter / definer: also carries the value being written.
+  SbxInterceptorScope(const char* name,
+                      v8::Local<v8::Name> key,
+                      v8::Local<v8::Value> value,
+                      const InfoType& info) {
+    if (SbxTracer::ScopeWorkDisabled()) {
+      return;
+    }
+    if (SbxTracer* tracer = SbxTracer::Get()) {
+      tracer->TraceInterceptorNamed(name, info.GetIsolate(), SbxReceiver(info),
+                                    key, value);
+    }
+  }
+
+  // Indexed setter / definer.
+  SbxInterceptorScope(const char* name,
+                      uint32_t index,
+                      v8::Local<v8::Value> value,
+                      const InfoType& info) {
+    if (SbxTracer::ScopeWorkDisabled()) {
+      return;
+    }
+    if (SbxTracer* tracer = SbxTracer::Get()) {
+      tracer->TraceInterceptorIndexed(name, info.GetIsolate(),
+                                      SbxReceiver(info), index, value);
+    }
+  }
+
+  // Enumerator / IndexOf / IterableToList: no key argument.
+  SbxInterceptorScope(const char* name, const InfoType& info) {
+    if (SbxTracer::ScopeWorkDisabled()) {
+      return;
+    }
+    if (SbxTracer* tracer = SbxTracer::Get()) {
+      tracer->TraceInterceptorNoKey(name, info.GetIsolate(),
+                                    SbxReceiver(info));
+    }
+  }
+
+  SbxInterceptorScope(const SbxInterceptorScope&) = delete;
+  SbxInterceptorScope& operator=(const SbxInterceptorScope&) = delete;
+};
+
+}  // namespace blink::sbxdiff
+
+// Emitted by bind_gen into every generated binding callback prologue. Declared
+// as a macro rather than written into runtime_call_stats.h because that header
+// is pulled in by v8_per_isolate_data.h/v8_dom_wrapper.h and therefore by
+// essentially all of Blink core and modules: editing it costs ~28,650 build
+// edges, whereas this header is included ONLY by generated bindings code, so an
+// edit costs ~1,152 leaf TUs. See docs/sbxdiff/CHROMIUM-PATCHES.md.
+#define SBX_BINDING_SCOPE(name, info) \
+  ::blink::sbxdiff::SbxBindingScope sbx_binding_scope(name, info)
+
+// Chokepoint B: named/indexed property interceptors. These do NOT receive
+// BLINK_BINDINGS_TRACE_EVENT, so without these macros window[name], coll[i] and
+// coll["name"] are completely untraced -- measured as zero records for 30
+// accesses each. window[name] is a classic sandbox-escape vector.
+#define SBX_INTERCEPTOR_SCOPE_NAMED(name, key, info) \
+  ::blink::sbxdiff::SbxInterceptorScope sbx_interceptor_scope(name, key, info)
+#define SBX_INTERCEPTOR_SCOPE_INDEXED(name, index, info) \
+  ::blink::sbxdiff::SbxInterceptorScope sbx_interceptor_scope(name, index, info)
+#define SBX_INTERCEPTOR_SCOPE(name, info) \
+  ::blink::sbxdiff::SbxInterceptorScope sbx_interceptor_scope(name, info)
+#define SBX_INTERCEPTOR_SCOPE_NAMED_VALUE(name, key, value, info) \
+  ::blink::sbxdiff::SbxInterceptorScope sbx_interceptor_scope(name, key, value, \
+                                                              info)
+#define SBX_INTERCEPTOR_SCOPE_INDEXED_VALUE(name, index, value, info)       \
+  ::blink::sbxdiff::SbxInterceptorScope sbx_interceptor_scope(name, index,  \
+                                                              value, info)
+
+#else  // !BUILDFLAG(SBXDIFF)
+
+// sbxdiff=false: the generated source still carries the call, but it compiles
+// to nothing, so the resulting binary is unchanged.
+#define SBX_BINDING_SCOPE(name, info) \
+  do {                                \
+  } while (false)
+#define SBX_INTERCEPTOR_SCOPE_NAMED(name, key, info) \
+  do {                                               \
+  } while (false)
+#define SBX_INTERCEPTOR_SCOPE_INDEXED(name, index, info) \
+  do {                                                   \
+  } while (false)
+#define SBX_INTERCEPTOR_SCOPE(name, info) \
+  do {                                    \
+  } while (false)
+#define SBX_INTERCEPTOR_SCOPE_NAMED_VALUE(name, key, value, info) \
+  do {                                                           \
+  } while (false)
+#define SBX_INTERCEPTOR_SCOPE_INDEXED_VALUE(name, index, value, info) \
+  do {                                                                \
+  } while (false)
+
+#endif  // BUILDFLAG(SBXDIFF)
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_SCOPE_H_
