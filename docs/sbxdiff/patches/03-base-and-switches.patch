+// sbxdiff: run key. ANY string works -- it is SHA-256'd (together with the
+// process type and renderer client id, so sibling processes get distinct
+// streams) into the ChaCha20 key. Presence of this switch makes base::RandBytes --
+// and therefore crypto.getRandomValues, crypto.randomUUID, UnguessableToken and
+// every other //base randomness consumer -- fully deterministic. Defined here
+// rather than in blink because the generator lives in //base and //base cannot
+// include blink; blink and content reference this constant so there is exactly
+// one definition. See docs/sbxdiff/DETERMINISM.md.
+inline constexpr char kSbxdiffRunKey[] = "sbxdiff-run-key";
+
+// sbxdiff: pins the initial virtual time, in milliseconds since the Unix
+// epoch. Virtual time makes time *deltas* deterministic but takes its origin
+// from the real clock (ThreadSchedulerBase::EnableVirtualTime falls back to
+// base::Time::Now()), so Date.now() and performance.timeOrigin still leak real
+// time. Lives here rather than in blink::switches so that every determinism
+// input has exactly one definition. Consumed in
+// third_party/blink/renderer/platform/scheduler/common/thread_scheduler_base.cc.
+inline constexpr char kSbxdiffInitialTime[] = "sbxdiff-initial-time";
+
+// sbxdiff: the wall clock's ORIGIN, in milliseconds since the Unix epoch,
+// without enabling virtual time.
+//
+// --sbxdiff-initial-time pins the origin AND makes the clock virtual, and a
+// sandbox cannot have virtual time at all: under a service worker the load
+// being waited on is served by the worker, whose transport needs timers, so
+// neither side ever moves (RULES.md #59). That left the sandbox on the real
+// wall clock while the oracle ran from a pinned origin -- a difference the
+// GUEST can read, and not only as a fingerprint. Cloudflare's JS detections
+// take the challenge's issue time out of `__CF$cv$params.t` and compare it
+// against `Date.now()`; replaying a recorded challenge hours later makes it
+// look stale, and the script stops without an error. Measured: the oracle
+// posted 16270 bytes to `jsd/oneshot` and the sandbox posted nothing, having
+// executed exactly six operations.
+//
+// So: offset, not virtual. `base::Time::Now()` is shifted by a delta fixed at
+// startup and then runs at real speed, which is what a sandbox needs -- the
+// same origin as the oracle, a clock that still advances on its own. TimeTicks
+// is deliberately untouched: it is monotonic-since-boot, has no epoch to
+// agree on, and is what `performance.now()` measures.
+//
+// Consumed in chrome/app/chrome_main_delegate.cc.
+inline constexpr char kSbxdiffTimeOffset[] = "sbxdiff-time-offset";
+
+// sbxdiff: caps how far virtual time may advance, in milliseconds, when
+// --sbxdiff-initial-time has enabled it early. This is a *fence*, not a run
+// length: without it an advancing clock fast-forwards to the next delayed task
+// whenever the scheduler is idle, which during startup means far-future
+// housekeeping timers (~97 minutes accrued, varying per run). Consumed in
+// third_party/blink/renderer/core/page/page.cc.
+inline constexpr char kSbxdiffVirtualTimeBudget[] =
+    "sbxdiff-virtual-time-budget";
+
+// sbxdiff: which virtual time policy to install -- "deterministic" (default),
+// "advance", or "pause".
+//
+// This exists because the default, kDeterministicLoading, DEADLOCKS a
+// service-worker sandbox. That policy pauses virtual time while a load is
+// outstanding; scramjet's load is served by a service worker whose transport
+// drives itself with timers, and those timers need virtual time to advance.
+// Load waits on timer, timer waits on load. Measured: the service worker
+// starts, the proxied navigation is issued, and no network request is ever
+// made.
+//
+// Consumed in third_party/blink/renderer/core/page/page.cc.
+inline constexpr char kSbxdiffVirtualTimePolicy[] =
+    "sbxdiff-virtual-time-policy";
+
+// sbxdiff: delay enabling virtual time until a realm whose document URL
+// contains this substring is set up, instead of enabling it in Page's
+// constructor.
+//
+// A sandbox needs this. Virtual time during *harness setup* breaks service
+// worker registration: measured on the scramjet harness, `deterministic` never
+// activates the worker at all and `advance` activates it three times (once is
+// correct) while the guest realm gets 2 records instead of 1746. None of that
+// is about the page under test -- it is the proxy's own bootstrap being run
+// under a clock that either will not move or moves too fast.
+//
+// Delaying to the guest realm gives both sides the same thing: a real clock for
+// setup, virtual time for the page actually being compared. It stays symmetric
+// because both runs enable at their own guest realm.
+//
+// Consumed in local_window_proxy.cc; suppresses the enable in page.cc.
+inline constexpr char kSbxdiffVirtualTimeAfter[] = "sbxdiff-virtual-time-after";
+
+// sbxdiff: restore Chromium's default of FENCING task queues while virtual
+// time is paused, instead of only stopping the clock.
+//
+// Not fencing is what lets a service-worker sandbox make progress (the load is
+// served by the page, so fencing the page deadlocks it). But it also means page
+// JS runs while the clock is frozen, which a page can notice -- a Cloudflare
+// challenge fails under it. This exists to tell those two apart.
+inline constexpr char kSbxdiffVirtualTimeFence[] = "sbxdiff-virtual-time-fence";
+
+// sbxdiff: serve an empty 200 for a replay miss instead of
+// ERR_BLOCKED_BY_CLIENT. The miss is still logged and counted -- it is a
+// divergence either way (RULES.md #14) -- but blocking is itself a behaviour
+// the recording never had.
+//
+// Needed for fire-and-forget telemetry. A Cloudflare challenge beacons to
+// `brunhild.challenges.cloudflare.com/.../h/g/i/...` as it finishes; the
+// request is issued but its response never reaches the recorder, so the store
+// has nothing for it. Hard-blocking that derails a challenge that had already
+// passed.
+inline constexpr char kSbxdiffNetReplaySoftMiss[] =
+    "sbxdiff-net-replay-soft-miss";
+
+// sbxdiff: use the in-binary run driver instead of --dump-dom /
+// --virtual-time-budget, which drive the target over CDP from a
+// chrome://headless/ page. Optional value is the real-time grace in ms after
+// the page stops loading (default 1000). See chrome/browser/headless/
+// sbxdiff_runner.h.
+inline constexpr char kSbxdiffRun[] = "sbxdiff-run";
+
+// sbxdiff: newline-separated URLs the network replay gate will allow. A request
+// not listed is recorded as blocked and refused -- a divergence, not an error
+// (RULES.md #14). Absent means the gate is inert.
+inline constexpr char kSbxdiffNetAllow[] = "sbxdiff-net-allow";
+
+// sbxdiff: record every finished subresource body into <dir>, for later replay.
+inline constexpr char kSbxdiffNetRecord[] = "sbxdiff-net-record";
+// sbxdiff: serve subresource bodies from <dir> instead of the network. A URL
+// with no stored body is a replay miss, i.e. a divergence (RULES.md #14).
+inline constexpr char kSbxdiffNetReplay[] = "sbxdiff-net-replay";
+
+// sbxdiff: bisection aid. Bitmask disabling parts of the tracer so one build
+// can test several hypotheses. MUST be in kSbxdiffRendererSwitches below --
+// it was added with a raw string literal and no relay entry, so every
+// "mask=N" measurement silently ran with the mask at 0, i.e. full tracing.
+// That invalidated an entire perf attribution and a crash bisect.
+inline constexpr char kSbxdiffDebugDisable[] = "sbxdiff-debug-disable";
+
+// sbxdiff: how to tell the proxy's OWN scripts from the pages it rewrites:
+// --sbxdiff-shim-scripts=<origin>,<prefix>.
+//
+// Both live on the same origin, and only the prefix separates them -- a guest
+// script is behind it and the shim's are not. That distinction is the
+// discriminator RULES.md #88, #89 and #99 each needed and none had: a counter
+// or a clock that must advance for the guest and not for the shim has no other
+// way to know which is running.
+//
+// Absent means nothing is a shim, which is right for the oracle: it has none.
+inline constexpr char kSbxdiffShimScripts[] = "sbxdiff-shim-scripts";
+
+// sbxdiff: synthesize a trusted left click at viewport coordinates once the
+// page settles: --sbxdiff-click=<x>,<y>[,<delay_ms>[,<repeat>[,<interval_ms>]]].
+//
+// Browser-process only (the runner reads it), so unlike the tracer switches it
+// does NOT belong in kSbxdiffRendererSwitches -- relaying it would be harmless
+// but meaningless.
+//
+// Needed for challenge widgets (Cloudflare Turnstile) that require a real
+// user gesture. The event is injected via RenderWidgetHost::ForwardMouseEvent,
+// the same path OS input takes, so it is a *trusted* event -- unlike
+// dispatchEvent from script -- and needs no DevTools session, which would be
+// page-observable and defeat the point.
+inline constexpr char kSbxdiffClick[] = "sbxdiff-click";
+
+// sbxdiff: periodic viewport screenshots: --sbxdiff-shots=<dir>[,interval_ms].
+//
+// Captured in-browser via RenderWidgetHostView::CopyFromSurface rather than
+// with the OS screenshot tool, which needs Screen Recording permission that a
+// headless/SSH session cannot grant ("could not create image from display").
+inline constexpr char kSbxdiffShots[] = "sbxdiff-shots";
+
+// sbxdiff: send --sbxdiff-click to the frame whose URL contains this substring,
+// with the click coordinates interpreted relative to that frame.
+//
+// RenderWidgetHost::ForwardMouseEvent delivers straight to one widget and skips
+// the browser-side hit-testing that routes a root-frame click down into a child
+// frame, and the router is not exposed in content/public. Targeting the child
+// widget directly is the part of that we can do with public API.
+inline constexpr char kSbxdiffClickFrame[] = "sbxdiff-click-frame";
+
+// Every sbxdiff switch the RENDERER reads. The relay in
+// render_process_host_impl.cc iterates this array, so adding a switch here is
+// all that is required.
+//
+// This list exists because forgetting the relay is the single most repeated bug
+// in this project -- five separate instances, each presenting as "the feature
+// silently does nothing in the renderer" with no error. Enumerating them once
+// turns a discipline problem into a mechanical one.
+inline constexpr const char* kSbxdiffRendererSwitches[] = {
+    kSbxdiffRunKey,
+    kSbxdiffInitialTime,
+    kSbxdiffTimeOffset,
+    kSbxdiffVirtualTimeBudget,
+    kSbxdiffVirtualTimePolicy,
+    kSbxdiffVirtualTimeAfter,
+    kSbxdiffVirtualTimeFence,
+    kSbxdiffNetReplaySoftMiss,
+    kSbxdiffNetAllow,
+    kSbxdiffNetRecord,
+    kSbxdiffNetReplay,
+    kSbxdiffDebugDisable,
+    kSbxdiffShimScripts,
+};
+
 }  // namespace switches
 
 #endif  // BASE_BASE_SWITCHES_H_
