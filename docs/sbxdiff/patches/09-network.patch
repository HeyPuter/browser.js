+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_SBXDIFF_SBXDIFF_REALM_CLOCK_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_SBXDIFF_SBXDIFF_REALM_CLOCK_H_
+
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink::sbxdiff {
+
+// Teach `base::sbxdiff`'s logical clock how to name the realm it is being read
+// in, for SBXDIFF_REALM_CLOCK.
+//
+// `Date.now()` reaches the clock through `gin::V8Platform`, which is handed no
+// context and cannot depend on Blink to find one. So Blink installs a resolver
+// and base calls back into it. The key is the `ExecutionContext` pointer, which
+// is per realm, stable for its lifetime, and needs no bookkeeping of its own.
+//
+// Idempotent, and cheap enough to call from anywhere that might be first.
+CORE_EXPORT void EnsureLogicalRealmResolver();
+
+}  // namespace blink::sbxdiff
+
