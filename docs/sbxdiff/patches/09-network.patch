+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_SBXDIFF_BODY_HASH_H_
+#define BASE_SBXDIFF_BODY_HASH_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace base::sbxdiff {
+
+// FNV-1a over a request body, rendered "<length>:<hash in base36>".
+//
+// A request body is guest-observable output in the strongest sense: it is what
+// the page TELLS the server about itself. Comparing the oracle's against the
+// sandbox's is the only check sbxdiff has that reaches divergences the API
+// trace never sees -- but the oracle builds its bodies here, in C++ inside the
+// network service, while the sandbox builds its own in the guest's JavaScript.
+// There is no object the two can share, only a string both can independently
+// derive, so the SAME hash has to exist in three places: here, `bodyHash` in
+// runway's `sbxdiff/store.ts`, and `SbxdiffTransport.hash` in
+// `sbxdiff-transport.js`. If they ever disagree the comparison silently stops
+// meaning anything -- every request looks divergent, or none do.
+//
+// Hence this header: no dependencies beyond the standard library, deliberately,
+// so `sbxdiff/bodyhash.test.ts` can compile it on its own in about a second and
+// hold all three to one set of golden vectors on every run.
+//
+// Not a digest. It only has to distinguish payloads, and it has to be cheap
+// enough to run on the request path of every load.
+inline std::string BodyHash(std::string_view body) {
+  uint32_t h = 0x811c9dc5u;
+  for (const char c : body) {
+    h ^= static_cast<uint8_t>(c);
+    h *= 0x01000193u;
+  }
+  std::string base36;
+  if (h == 0) {
+    base36 = "0";
+  }
+  while (h) {
+    base36.push_back("0123456789abcdefghijklmnopqrstuvwxyz"[h % 36]);
+    h /= 36;
+  }
+  std::reverse(base36.begin(), base36.end());
+  return std::to_string(body.size()) + ":" + base36;
+}
+
+}  // namespace base::sbxdiff
+
+#endif  // BASE_SBXDIFF_BODY_HASH_H_
