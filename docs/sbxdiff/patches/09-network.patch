+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/sbxdiff/sbxdiff_realm_clock.h"
+
+#include "base/sbxdiff_observable_clock.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/platform/bindings/v8_binding.h"
+#include "v8/include/v8-context.h"
+#include "v8/include/v8-isolate.h"
+
+namespace blink::sbxdiff {
+
+namespace {
+
+// The realm a read is happening in, as its ExecutionContext pointer.
+//
+// 0 for anything with no entered context -- a platform callback, a timer
+// firing before any script -- and everything in that state shares one slot,
+// which is right: they are not any realm's time.
+uint64_t CurrentRealmKey() {
+  v8::Isolate* isolate = v8::Isolate::TryGetCurrent();
+  if (!isolate || !isolate->InContext()) {
+    return 0;
+  }
+  // The ENTERED context, not the current one: a binding reached from another
+  // realm's code should be charged to the realm whose script is running, which
+  // is the same rule the tracer's realm id follows.
+  v8::Local<v8::Context> context = isolate->GetEnteredOrMicrotaskContext();
+  if (context.IsEmpty()) {
+    context = isolate->GetCurrentContext();
+  }
+  if (context.IsEmpty()) {
+    return 0;
+  }
+
+  return reinterpret_cast<uint64_t>(ExecutionContext::From(context));
+}
+
+}  // namespace
+
+void EnsureLogicalRealmResolver() {
+  if (!base::sbxdiff::RealmClockEnabled()) {
+    return;
+  }
+  static bool installed = false;
+  if (installed) {
+    return;
+  }
+  installed = true;
+  base::sbxdiff::SetLogicalRealmResolver(&CurrentRealmKey);
+}
+
+}  // namespace blink::sbxdiff
