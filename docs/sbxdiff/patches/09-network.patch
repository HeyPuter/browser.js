+
+#ifndef CHROME_BROWSER_HEADLESS_SBXDIFF_NET_REPLAY_H_
+#define CHROME_BROWSER_HEADLESS_SBXDIFF_NET_REPLAY_H_
+
+namespace network {
+class URLLoaderFactoryBuilder;
+}
+
+namespace sbxdiff {
+
+// sbxdiff: serves every network request from the recorded store, so a replayed
+// run touches no server at all.
+//
+// Installed as a URLLoaderFactory interceptor in the browser process, which is
+// the only layer that sees *every* request uniformly -- navigation, subresource,
+// fetch()/XHR, worker scripts. Earlier attempts sat in Blink's ResourceFetcher
+// and could not cover navigation (DocumentLoader does not go through it) or
+// fetch()/XHR (ResourceType::kRaw refuses the synthetic-body path).
+//
+// Strict by design: a URL with no recorded body is **not** fetched from the
+// network. It is failed with ERR_BLOCKED_BY_CLIENT, which surfaces as a replay
+// miss rather than silently breaking hermeticity (RULES.md #14). That also
+// means this never needs to proxy to a real factory, so there is no data-pipe
+// teeing here -- recording happens separately, in the renderer, via Blink
+// probes.
+//
+// No-op unless --sbxdiff-net-replay is set.
+void MaybeInstallReplayInterceptor(network::URLLoaderFactoryBuilder& builder);
+
+}  // namespace sbxdiff
+
+#endif  // CHROME_BROWSER_HEADLESS_SBXDIFF_NET_REPLAY_H_
