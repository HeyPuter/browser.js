+# sbxdiff: interceptor callbacks that are wrapped with SBX_INTERCEPT at their
+# registration sites. The v8 context snapshot serializes the *installed*
+# function pointers and resolves them against this table, so an entry missing
+# here fails the snapshot build with "Unknown external reference" -- which is
+# exactly what happened when only the registration sites were wrapped.
+_SBX_DECLINING_INTERCEPTOR_KINDS = ("Getter", "Setter", "Query", "Deleter",
+                                    "Definer", "Descriptor")
+
+
+def _sbx_is_wrapped_interceptor(callback_name):
+    """True if SBX_INTERCEPT is applied to this callback at its install site."""
+    base = callback_name.rsplit("::", 1)[-1]
+    if not base.endswith("Callback"):
+        return False
+    kind = base[:-len("Callback")]
+    for prefix in ("CrossOriginNamed", "CrossOriginIndexed", "NamedProperty",
+                   "IndexedProperty"):
+        if kind.startswith(prefix):
+            return kind[len(prefix):] in _SBX_DECLINING_INTERCEPTOR_KINDS
+    return False
+
+
+def _sbx_add_ref_table_entries(callback_names):
+    """Adds the wrapper address alongside each wrapped interceptor.
+
+    Both are kept: the wrapper is what the templates install and therefore what
+    the snapshot must resolve, and leaving the raw entry in place costs one
+    pointer while keeping the table a superset of anything else that might
+    reference it.
+    """
+    extra = [
+        "SBX_INTERCEPT({})".format(name) for name in callback_names
+        if name and _sbx_is_wrapped_interceptor(name)
+    ]
+    callback_names.extend(extra)
+
