 namespace {
 
+// sbxdiff: deterministic replacement for the OS entropy source.
+//
+// This is the single chokepoint for all of //base's randomness, and therefore
+// covers RandUint64, RandDouble, RandFloat, RandBool, RandGenerator,
+// RandBytesAsVector/String, RandomBitGenerator, RandomShuffle,
+// InsecureRandomGenerator's seed, UnguessableToken, Token, crypto::RandBytes,
+// crypto.getRandomValues and crypto.randomUUID -- plus PartitionAlloc's and the
+// network stack's draws. Math.random is NOT here; it lives in V8 and is pinned
+// with --random-seed instead.
+//
+// Stateless and counter-based, so a differing *number* of draws in one stream
+// cannot desynchronize another: the keystream is a pure function of
+// (run_key, stream_id, draw_index). The 96-bit ChaCha20 nonce holds
+// stream_id (32 bits) || draw_index (64 bits) exactly, so every draw gets a
+// fresh keystream and the block counter always starts at 0.
+//
+// stream_id is per-thread. A single global counter would make output depend on
+// inter-thread interleaving, which is precisely the nondeterminism we are
+// removing. Attribution-based streams (guest vs. shim, plan P6) are a later
+// refinement; a per-thread stream is what the direct-vs-direct self-diff gate
+// needs.
+//
+// See docs/sbxdiff/DETERMINISM.md.
+// Is this explicit stream one whose bytes must be the SAME in every process?
+//
+// Anything a page can READ or SEND has to be, because the oracle and the
+// sandbox do not create the same processes in the same order -- the sandbox
+// runs a proxy harness and a service worker first -- so the same logical realm
+// gets a different `renderer-client-id` on the two sides. Mixing that into the
+// key made every pinned draw differ between them. Measured on rateyourmusic:
+// every Cloudflare payload agreed on ZERO bytes, because even the RSA-wrapped
+// key block was drawn from a different keystream, and `/httprequest/SecChk`
+// agreed on 24 of 2450 -- the literal `----WebKitFormBoundary`, then sixteen
+// different random characters.
+//
+// Blob UUIDs are the exception and must stay process-DISTINCT: they are
+// registered in the browser process and shared across renderers, so two
+// renderers generating the same one is a duplicate registration and the second
+// renderer is killed ("Invalid UUID passed to BlobRegistry::Register"),
+// which on rateyourmusic killed the Cloudflare iframe outright.
+bool SbxdiffStreamIsCrossProcess(uint32_t stream_id) {
+  switch (stream_id) {
+    case kSbxdiffStreamWebCrypto:
+    case kSbxdiffStreamFormBoundary:
+    case kSbxdiffStreamTimeClamper:
+    case kSbxdiffStreamMdnsName:
+      return true;
+    default:
+      // Including kSbxdiffStreamBlobUuid and every automatic per-thread stream.
+      return false;
+  }
+}
+
+bool SbxdiffRunKey(bool with_process_identity,
+                   std::array<uint8_t, 32>* out) {
+  const auto derive = [](bool mix_process)
+      -> std::optional<std::array<uint8_t, 32>> {
+    const CommandLine* cmd = CommandLine::ForCurrentProcess();
+    if (!cmd || !cmd->HasSwitch(switches::kSbxdiffRunKey)) {
+      return std::nullopt;
+    }
+    // Any string is accepted, because the key is SHA-256 of the switch value.
+    // An earlier version parsed a decimal integer, which meant a non-numeric
+    // key was silently ignored and the run fell back to real OS entropy --
+    // indistinguishable from a genuine divergence. Presence of the switch,
+    // not the shape of its value, is what enables determinism (RULES.md #13).
+    std::string material = cmd->GetSwitchValueASCII(switches::kSbxdiffRunKey);
+
+    // The process identity MUST be mixed in. stream_id is a per-process
+    // counter, so without this every renderer's main thread got stream 16 at
+    // draw 0 and therefore generated the *same* byte sequence -- including the
+    // same base::Uuid::GenerateRandomV4() values. Blob UUIDs are registered in
+    // the browser process, shared across renderers, so the second renderer to
+    // register hit a duplicate and was killed:
+    //
+    //   Terminating render process for bad Mojo message:
+    //     Invalid UUID passed to BlobRegistry::Register
+    //
+    // Measured on rateyourmusic.com: 1 such kill with --sbxdiff-run-key, 0
+    // without. It killed the Cloudflare challenge iframe, so the page could
+    // never pass. Any multi-process site would hit this.
+    //
+    // These two switch names mirror content::switches::kProcessType and
+    // kRendererClientId. //base cannot include //content, so they are spelled
+    // out here on purpose. Both are stable, and the client id is assigned in
+    // process-creation order, so it is reproducible across runs of the same
+    // page -- which is what keeps the PRNG deterministic while making each
+    // process's streams distinct.
+    static constexpr char kProcessTypeSwitch[] = "type";
+    static constexpr char kRendererClientIdSwitch[] = "renderer-client-id";
+    if (mix_process) {
+      material.push_back('\0');
+      material.append(cmd->GetSwitchValueASCII(kProcessTypeSwitch));
+      material.push_back('\0');
+      material.append(cmd->GetSwitchValueASCII(kRendererClientIdSwitch));
+    }
+
+    const span<const uint8_t> bytes = as_byte_span(material);
+    std::array<uint8_t, 32> derived = {};
+    SHA256(bytes.data(), bytes.size(), derived.data());
+    return derived;
+  };
+  static const std::optional<std::array<uint8_t, 32>> per_process = derive(true);
+  static const std::optional<std::array<uint8_t, 32>> shared = derive(false);
+  const auto& key = with_process_identity ? per_process : shared;
+  if (!key.has_value()) {
+    return false;
+  }
+  *out = key.value();
+  return true;
+}
+
+// Explicit stream selected by SbxdiffScopedRandStream, 0 when none is active.
+thread_local uint32_t g_sbx_stream = 0;
+// One counter per explicit stream id (index 0 unused).
+thread_local std::array<uint64_t, kSbxdiffFirstAutoStream> g_sbx_stream_draw =
+    {};
+// An EXTERNAL counter supplied by the caller, or null for the per-thread one
+// above. Set for draws that belong to a realm rather than to a thread: the two
+// sides do not put the same realms on the same threads, so a per-thread index
+// is shifted by whatever ran first and the guest's Nth draw is not the Nth on
+// both sides. See base/sbxdiff_rand_stream.h.
+thread_local uint64_t* g_sbx_stream_counter = nullptr;
+
+bool SbxdiffRandBytes(span<uint8_t> output) {
+  // Automatic per-thread streams start above the reserved explicit range.
+  static std::atomic<uint32_t> next_stream_id{kSbxdiffFirstAutoStream};
+  thread_local const uint32_t auto_stream_id =
+      next_stream_id.fetch_add(1, std::memory_order_relaxed);
+  thread_local uint64_t auto_draw_index = 0;
+
+  std::array<uint8_t, 32> key = {};
+  if (!SbxdiffRunKey(!SbxdiffStreamIsCrossProcess(g_sbx_stream), &key)) {
+    return false;
+  }
+
+  uint32_t stream_id = auto_stream_id;
+  uint64_t draw = 0;
+  if (g_sbx_stream != 0 && g_sbx_stream < g_sbx_stream_draw.size()) {
+    // An explicit stream has its own counter, so unrelated draws on this
+    // thread cannot shift it -- and an external one narrows that further to a
+    // single realm, so draws in OTHER realms on the same thread cannot either.
+    stream_id = g_sbx_stream;
+    draw = g_sbx_stream_counter ? (*g_sbx_stream_counter)++
+                                : g_sbx_stream_draw[g_sbx_stream]++;
+  } else {
+    draw = auto_draw_index++;
+  }
+
+  std::array<uint8_t, 12> nonce = {};
+  for (size_t i = 0; i < sizeof(stream_id); ++i) {
+    nonce[i] = static_cast<uint8_t>(stream_id >> (8 * i));
+  }
+  for (size_t i = 0; i < sizeof(draw); ++i) {
+    nonce[4 + i] = static_cast<uint8_t>(draw >> (8 * i));
+  }
+
+  // CRYPTO_chacha_20 XORs the keystream into `in`; aliasing in==out is allowed
+  // when the pointers are equal, so zeroing the output first yields the raw
+  // keystream without a second buffer.
+  std::ranges::fill(output, 0u);
+  CRYPTO_chacha_20(output.data(), output.data(), output.size(), key.data(),
+                   nonce.data(), /*counter=*/0);
+  return true;
+}
+
 void RandBytesInternal(span<uint8_t> output, bool avoid_allocation) {
+  // sbxdiff: must come first -- every other path below reads real OS entropy.
+  if (SbxdiffRandBytes(output)) {
+    return;
+  }
   // The BoringSSL experiment takes priority over everything else.
   if (!avoid_allocation && internal::UseBoringSSLForRandBytes()) {
     // BoringSSL's RAND_bytes always returns 1. Any error aborts the program.
@@ -170,6 +351,23 @@ void RandBytes(span<uint8_t> output) {
   RandBytesInternal(output, /*avoid_allocation=*/false);
 }
 
+SbxdiffScopedRandStream::SbxdiffScopedRandStream(uint32_t stream_id)
+    : SbxdiffScopedRandStream(stream_id, nullptr) {}
+
+SbxdiffScopedRandStream::SbxdiffScopedRandStream(uint32_t stream_id,
+                                                 uint64_t* counter)
+    : previous_(g_sbx_stream), previous_counter_(g_sbx_stream_counter) {
+  CHECK_GT(stream_id, 0u);
+  CHECK_LT(stream_id, kSbxdiffFirstAutoStream);
+  g_sbx_stream = stream_id;
+  g_sbx_stream_counter = counter;
+}
+
+SbxdiffScopedRandStream::~SbxdiffScopedRandStream() {
+  g_sbx_stream = previous_;
+  g_sbx_stream_counter = previous_counter_;
+}
