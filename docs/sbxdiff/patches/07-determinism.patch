+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_SCHEDULER_COMMON_SBXDIFF_VIRTUAL_TIME_H_
+
+#include <string>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+// sbxdiff: the command-line half of virtual time, shared by everything that
+// enables it -- Page's constructor, LocalWindowProxy (deferred enable) and
+// WorkerThreadScheduler (the worker joining the page's clock).
+//
+// These live in the scheduler rather than next to the tracer because they are
+// scheduler concerns and nothing here touches bindings. The scheduler's DEPS
+// forbids platform/ outside a small allow-list, and a tracer header does not
+// belong on that list.
+//
+// See docs/sbxdiff/CHROMIUM-PATCHES.md.
+namespace blink::sbxdiff {
+
+// 0 = kAdvance, 1 = kPause, 2 = kDeterministicLoading. Returned as an int so
+// this header stays free of scheduler types; each call site maps it.
+PLATFORM_EXPORT int VirtualTimePolicyFromSwitch();
+
+// --sbxdiff-virtual-time-budget, in milliseconds. Defaults to 2000.
+PLATFORM_EXPORT int64_t VirtualTimeBudgetFromSwitch();
+
+// Budget for a renderer that hosts only a cross-origin subframe, which has no
+// page work pacing its clock and so fast-forwards to a run-dependent place.
+// SBXDIFF_SUBFRAME_VT_BUDGET_MS, default 5000.
+PLATFORM_EXPORT int64_t SubframeVirtualTimeBudgetFromEnv();
+
+// True when --sbxdiff-virtual-time-after is set: Page's constructor then skips
+// enabling virtual time and leaves it to the realm that matches.
+PLATFORM_EXPORT bool VirtualTimeIsDeferred();
+
+// True when `url` contains the value of --sbxdiff-virtual-time-after, i.e.
+// this is the realm whose setup should start virtual time.
+PLATFORM_EXPORT bool IsVirtualTimeStartRealm(const std::string& url);
+
+// Latch: false until the start realm has enabled virtual time. Read from
+// worker threads, which join the page's clock lazily once it is set, so the
+// storage is atomic.
+// True when --sbxdiff-virtual-time-fence asks for Chromium's default fencing.
+PLATFORM_EXPORT bool VirtualTimeFencesQueues();
+
+PLATFORM_EXPORT bool VirtualTimeHasStarted();
+PLATFORM_EXPORT void MarkVirtualTimeStarted();
+
+}  // namespace blink::sbxdiff
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_SCHEDULER_COMMON_SBXDIFF_VIRTUAL_TIME_H_
