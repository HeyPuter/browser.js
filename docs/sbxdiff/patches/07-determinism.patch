@@ -0,0 +1,118 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/scheduler/common/sbxdiff_virtual_time.h"
+
+#include <atomic>
+
+#include "base/base_switches.h"
+#include <cstdlib>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace blink::sbxdiff {
+
+namespace {
+
+// Written once on the main thread when the page's start realm enables virtual
+// time; read on worker threads, which join it lazily. One process-wide clock,
+// so not thread_local, and atomic because the read is cross-thread.
+//
+// Relaxed ordering is enough: the flag guards nothing but "should I also call
+// EnableVirtualTime", and the coordinator does its own locking.
+std::atomic<bool> g_virtual_time_started{false};
+
+}  // namespace
+
+int VirtualTimePolicyFromSwitch() {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  const std::string name =
+      cmd ? cmd->GetSwitchValueASCII(::switches::kSbxdiffVirtualTimePolicy)
+          : std::string();
+  if (name == "advance") {
+    return 0;
+  }
+  if (name == "pause") {
+    return 1;
+  }
+  return 2;
+}
+
+int64_t VirtualTimeBudgetFromSwitch() {
+  int64_t budget_ms = 2000;
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd && cmd->HasSwitch(::switches::kSbxdiffVirtualTimeBudget)) {
+    std::ignore = base::StringToInt64(
+        cmd->GetSwitchValueASCII(::switches::kSbxdiffVirtualTimeBudget),
+        &budget_ms);
+  }
+  return budget_ms;
+}
+
+int64_t SubframeVirtualTimeBudgetFromEnv() {
+  // A renderer that hosts only a cross-origin subframe has nothing pacing its
+  // clock. Chromium's ProcessTimeOverrideCoordinator is PER-PROCESS, so that
+  // renderer's virtual time advances entirely on its own, and with no page work
+  // to hold it back it fast-forwards to whatever far-future timer happens to be
+  // pending -- which is a different set on every run.
+  //
+  // Measured on rateyourmusic, in Cloudflare's blob worker, scoped with
+  // --realm challenges.cloudflare.com: `performance.now()` is read 10028 times
+  // and answered 345123 in one oracle run against 602509 in the next. 257
+  // seconds apart, stamped into the challenge payload ten thousand times, and
+  // invisible from the page's own realm, which reports zero divergences.
+  //
+  // The budget fence is the only thing that stops the fast-forward, so give
+  // such a renderer a TIGHT one: the clock reaches the fence on its first idle
+  // moment and then stays there, which makes every subsequent read the same
+  // value in every run. A large budget does not do this -- it just moves where
+  // the two runs stop disagreeing.
+  static const int64_t ms = [] {
+    const char* v = ::getenv("SBXDIFF_SUBFRAME_VT_BUDGET_MS");
+    if (!v || !*v) {
+      return int64_t{5000};
+    }
+    int64_t parsed = 0;
+    for (std::string_view digits(v); char c : digits) {
+      if (c < '0' || c > '9' || parsed > (1LL << 40)) {
+        return int64_t{5000};
+      }
+      parsed = parsed * 10 + (c - '0');
+    }
+    return parsed;
+  }();
+  return ms;
+}
+
+bool VirtualTimeIsDeferred() {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd && cmd->HasSwitch(::switches::kSbxdiffVirtualTimeAfter);
+}
+
+bool IsVirtualTimeStartRealm(const std::string& url) {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd || !cmd->HasSwitch(::switches::kSbxdiffVirtualTimeAfter)) {
+    return false;
+  }
+  const std::string want =
+      cmd->GetSwitchValueASCII(::switches::kSbxdiffVirtualTimeAfter);
+  return !want.empty() && url.find(want) != std::string::npos;
+}
+
+bool VirtualTimeFencesQueues() {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd && cmd->HasSwitch(::switches::kSbxdiffVirtualTimeFence);
+}
+
+bool VirtualTimeHasStarted() {
+  return g_virtual_time_started.load(std::memory_order_relaxed);
+}
+
+void MarkVirtualTimeStarted() {
+  g_virtual_time_started.store(true, std::memory_order_relaxed);
+}
+
+}  // namespace blink::sbxdiff
