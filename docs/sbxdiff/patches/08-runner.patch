 #include "chrome/common/chrome_result_codes.h"
 #include "chrome/common/chrome_switches.h"
 #include "chrome/common/crash_keys.h"
@@ -1113,6 +1118,77 @@ void ChromeMainDelegate::SetupTracing() {
 }
 
 std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
+  // sbxdiff: validate switch *syntax* here, the earliest callback, so a bad
+  // value aborts the whole run with a clear message before any child process
+  // is spawned. The renderer-side CHECK remains as a backstop, but on its own
+  // it is the wrong kind of loud: it kills the renderer and leaves a headless
+  // run hanging, which is the silent-failure shape RULES.md #13 exists to
+  // prevent. Returning a value from this function exits with that code.
+  {
+    const base::CommandLine* sbx_cmd = base::CommandLine::ForCurrentProcess();
+    for (const char* sbx_switch : {::switches::kSbxdiffInitialTime,
+                                   ::switches::kSbxdiffTimeOffset,
+                                   ::switches::kSbxdiffVirtualTimeBudget}) {
+      if (!sbx_cmd || !sbx_cmd->HasSwitch(sbx_switch)) {
+        continue;
+      }
+      const std::string value = sbx_cmd->GetSwitchValueASCII(sbx_switch);
+      int64_t unused_ms = 0;
+      if (!base::StringToInt64(value, &unused_ms)) {
+        LOG(ERROR) << "--" << sbx_switch
+                   << " must be an integer number of milliseconds, got: "
+                   << value;
+        return CHROME_RESULT_CODE_INVALID_CMDLINE_URL;
+      }
+    }
+
+    // sbxdiff: shift the wall clock's ORIGIN without making it virtual.
+    //
+    // A sandbox cannot have virtual time (RULES.md #59), so it ran on the real
+    // wall clock while the oracle ran from a pinned origin. That is guest
+    // readable, and not only as a fingerprint: Cloudflare's JS detections take
+    // the challenge's issue time out of `__CF$cv$params.t` and compare it
+    // against `Date.now()`, so a recorded challenge replayed hours later looks
+    // stale and the script stops without an error.
+    //
+    // The delta is computed once, here, before any thread is reading the
+    // clock, and then `Time::Now()` runs at real speed from the new origin.
+    // `TimeNowIgnoringOverride` on both sides of the arithmetic so this
+    // composes with, rather than fights, any other override.
+    if (sbx_cmd && sbx_cmd->HasSwitch(::switches::kSbxdiffTimeOffset)) {
+      int64_t origin_ms = 0;
+      if (base::StringToInt64(
+              sbx_cmd->GetSwitchValueASCII(::switches::kSbxdiffTimeOffset),
+              &origin_ms)) {
+        static base::TimeDelta g_sbxdiff_time_delta =
+            (base::Time::UnixEpoch() + base::Milliseconds(origin_ms)) -
+            base::subtle::TimeNowIgnoringOverride();
+        // NoDestructor: the override must outlive every thread that reads
+        // the clock, and tearing it down at exit would be both pointless and
+        // a -Wexit-time-destructors error.
+        static base::NoDestructor<base::subtle::ScopedTimeClockOverrides>
+            g_sbxdiff_clock(
+                []() {
+                  return base::subtle::TimeNowIgnoringOverride() +
+                         g_sbxdiff_time_delta;
+                },
+                nullptr, nullptr);
+        // sbxdiff: and publish the same origin to the LOGICAL clock.
+        //
+        // Only here, which means only on the side that has no virtual time --
+        // --sbxdiff-time-offset and --sbxdiff-initial-time are mutually
+        // exclusive in the harness. That is the point: the oracle gets its
+        // progression from virtual time, and this gives the sandbox the same
+        // progression without fencing the scheduler, which is the part the
+        // sandbox cannot survive (RULES.md #81).
+        //
+        // Inert unless SBXDIFF_LOGICAL_CLOCK is set.
+        base::sbxdiff::SetLogicalClockOrigin(base::Time::UnixEpoch() +
+                                             base::Milliseconds(origin_ms));
+      }
+    }
+  }
+
 #if BUILDFLAG(IS_CHROMEOS)
   ash::BootTimesRecorder::Get()->SaveChromeMainStats();
 #endif
