+def _FillSDKPathAndVersionCommandLineTools(settings):
+    """sbxdiff: CommandLineTools fallback for FillSDKPathAndVersion.
+
+    A CommandLineTools-only install does not support `xcrun -sdk <platform>`
+    ("unable to lookup item 'PlatformPath'"), so query the active SDK directly.
+    Of these fields the mac build only consumes `sdk_path`; `sdk_platform_path`
+    and `toolchains_path` are read solely by build/config/ios, so best-effort
+    values are sufficient here.
+    """
+    def xcrun(*args):
+        return (
+            subprocess.check_output(['xcrun'] + list(args))
+            .decode('UTF-8')
+            .strip()
+        )
+
+    dev_dir = (
+        subprocess.check_output(['xcode-select', '-print-path'])
+        .decode('UTF-8')
+        .strip()
+    )
+
+    # Prefer the SDK version Chromium officially builds against, read from
+    # mac_sdk.gni so this tracks Chromium rolls instead of being hardcoded.
+    # This matters: CLT's MacOSX.sdk symlink points at the newest installed SDK,
+    # and SDK 27.0's libSystem.tbd declares `arm64e.x1-macos` targets that the
+    # bundled lld cannot parse ("could not load TAPI file ... unknown target").
+    sdk_path = ''
+    gni = os.path.join(
+        os.path.dirname(os.path.abspath(__file__)), '..', 'mac', 'mac_sdk.gni'
+    )
+    try:
+        with open(gni, encoding='utf-8') as f:
+            for line in f:
+                if line.strip().startswith('mac_sdk_official_version'):
+                    want = line.split('=', 1)[1].strip().strip('"')
+                    candidate = os.path.join(
+                        dev_dir, 'SDKs', 'MacOSX%s.sdk' % want
+                    )
+                    if os.path.isdir(candidate):
+                        sdk_path = candidate
+                    break
+    except OSError:
+        pass
+
+    if sdk_path:
+        settings['sdk_path'] = sdk_path
+        settings['sdk_version'] = xcrun('-sdk', sdk_path, '--show-sdk-version')
+        settings['sdk_build'] = xcrun(
+            '-sdk', sdk_path, '--show-sdk-build-version'
+        )
+    else:
+        settings['sdk_path'] = xcrun('--show-sdk-path')
+        settings['sdk_version'] = xcrun('--show-sdk-version')
+        settings['sdk_build'] = xcrun('--show-sdk-build-version')
+
+    settings['sdk_platform_path'] = ''
+    settings['toolchains_path'] = os.path.join(dev_dir, 'usr')
+
+
 def FillSDKPathAndVersion(settings, platform, xcode_version):
     """Fills the SDK path and version for |platform| into |settings|."""
+    try:
+        # Probe with --show-sdk-platform-path: it is the one query a
+        # CommandLineTools-only install cannot answer.
+        subprocess.check_output(
+            ['xcrun', '-sdk', platform, '--show-sdk-platform-path'],
+            stderr=subprocess.DEVNULL,
+        )
+    except (subprocess.CalledProcessError, OSError):
+        _FillSDKPathAndVersionCommandLineTools(settings)
+        return
+
     settings['sdk_path'] = (
         subprocess.check_output(['xcrun', '-sdk', platform, '--show-sdk-path'])
         .decode('UTF-8')
