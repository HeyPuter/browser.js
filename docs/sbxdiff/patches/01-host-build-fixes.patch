@@ -26,6 +26,19 @@ ScopedCGWindowID::ScopedCGWindowID(uint32_t cg_window_id,
     : cg_window_id_(cg_window_id),
       frame_sink_id_(frame_sink_id),
       weak_factory_(this) {
+  // sbxdiff: 0 is not a valid CGWindowID. Headless windows have no backing
+  // NSWindow, so NSWindow.windowNumber is 0 for all of them and a second
+  // window collides in this map -- fatal under dcheck_always_on:
+  //   DCHECK failed: GetMap().count(cg_window_id) == 0u (1 vs. 0)
+  // There is nothing to capture for such a window, so skip registration rather
+  // than weaken the invariant for real window ids.
+  // See docs/sbxdiff/CHROMIUM-PATCHES.md #0004.
+  // Unconditional, NOT gated on the sbxdiff switch: this is a plain bug fix,
+  // not an sbxdiff behaviour change. Gating it made the binary crash on every
+  // headless run that did not pass --sbxdiff-trace-out.
+  if (cg_window_id == 0) {
+    return;
+  }
   DCHECK_EQ(GetMap().count(cg_window_id), 0u);
   GetMap()[cg_window_id] = this;
 }
