+//
+// sbxdiff: the trace sink for the browser.js/scramjet differential oracle.
+//
+// Lives in platform/bindings/ rather than core/ on purpose: bind_gen emits the
+// BLINK_BINDINGS_TRACE_EVENT macro into BOTH bindings/core/v8 (549 files) and
+// bindings/modules/v8 (603 files), and blink_platform is the only component
+// visible to both. See docs/sbxdiff/ARCHITECTURE.md.
+//
+// HARD RULE (docs/sbxdiff/RULES.md #1): nothing reachable from here may execute
+// page JS. The encoder body runs inside a DisallowJavascriptExecutionScope with
+// kCrashOnFailure in DCHECK builds so that is enforced mechanically rather than
+// by review.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_TRACER_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_SBXDIFF_SBX_TRACER_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
