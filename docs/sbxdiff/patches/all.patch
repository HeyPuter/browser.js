+++ b/base/sbxdiff_observable_clock.h
@@ -0,0 +1,87 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_SBXDIFF_OBSERVABLE_CLOCK_H_
+#define BASE_SBXDIFF_OBSERVABLE_CLOCK_H_
+
+#include "base/base_export.h"
+#include "base/time/time.h"
+
+namespace base::sbxdiff {
+
+// sbxdiff: separates what a page READS from what the scheduler RUNS on.
+//
+// A renderer that hosts only a cross-origin subframe has its own virtual clock
+// -- Chromium's ProcessTimeOverrideCoordinator is per-process -- and nothing in
+// it paces that clock, so on its first idle moment it fast-forwards to whatever
+// far-future timer happens to be pending. Which timers those are differs run to
+// run. Measured in Cloudflare's blob worker: `performance.now()` read 10028
+// times and answered 345123 in one oracle run against 602509 in the next, and
+// `Date.now()` put 50.6 seconds of real difference into a challenge payload.
+//
+// Fencing the SCHEDULER there does not work. A tight fence parks the clock and
+// the widget never does its work -- 6 of 8 request bodies became "the oracle
+// never sent this" -- and a looser one hangs the run outright, because timers
+// beyond the fence never fire. The clock has to keep moving.
+//
+// So it keeps moving, and only the value handed to script is capped. Past the
+// ceiling every read is the same number in every run, while setTimeout still
+// sees the real virtual clock.
+//
+// Lives in //base because both halves of the answer need it and they are in
+// different components: Blink's DOMHighResTimeStamp conversion, and gin's
+// V8Platform, which is where `Date.now()` bottoms out.
+
+// The LOGICAL clock: origin + however much timer time has elapsed.
+//
+// Driven by timer SEMANTICS rather than by reads or by the wall clock. When a
+// 100 ms timer fires, it has advanced 100 ms -- which is what a per-read
+// counter could not do, and why that hung a page whose retry loop waits on
+// elapsed wall time (RULES.md #94).
+//
+// The point is to give the sandbox the progression the oracle gets from virtual
+// time, whose clock also advances to scheduled wake-ups, WITHOUT fencing the
+// scheduler -- the fencing is what the sandbox cannot survive (rule 81). Two
+// runs of the same guest code schedule the same delays, so they reach the same
+// logical time.
+//
+// SBXDIFF_LOGICAL_CLOCK=1 enables it; off by default and inert unless an origin
+// is set.
+BASE_EXPORT void SetLogicalClockOrigin(Time origin);
+BASE_EXPORT bool LogicalClockEnabled();
+// Elapsed logical time, for scheduling a timer's due point.
+BASE_EXPORT TimeDelta LogicalElapsed();
+
+// Per-REALM logical clocks, behind SBXDIFF_REALM_CLOCK.
+//
+// The clock is one counter for the whole run (RULES.md #104), which is what a
+// clock is -- and it means the page realm's timers advance every other realm's
+// clock too. On rateyourmusic the page polls every 550 ms while the challenge
+// loads, so by the time Cloudflare's widget serialises its first payload the
+// two sides are four rounds apart: "2026-09-12T23:40:17.159Z" against
+// "...19.359Z", 2200 ms, in an otherwise identical payload (RULES.md #123).
+//
+// Keyed per realm, the widget's clock advances only on the widget's own timers
+// -- a chain that is identical on both sides -- and the page's poll cannot
+// reach it.
+//
+// The cost is real and is why this is a flag rather than the default: two
+// frames can then postMessage each other `Date.now()` and disagree, which no
+// real browser does. Off unless asked for.
+BASE_EXPORT bool RealmClockEnabled();
+
+// Installed by Blink, which is the only layer that can name the realm a read is
+// happening in. `Date.now()` arrives through gin with no context argument, so
+// the resolver walks V8's current context instead. Returns 0 when there is no
+// realm, which shares one slot with everything else that has none.
+using LogicalRealmResolver = uint64_t (*)();
+BASE_EXPORT void SetLogicalRealmResolver(LogicalRealmResolver resolver);
+// Move the clock forward to `due`; never backwards.
+BASE_EXPORT void AdvanceLogicalTo(TimeDelta due);
+// `origin + LogicalElapsed()`, or `t` when the clock is off.
+BASE_EXPORT Time LogicalNow(Time t);
+
+}  // namespace base::sbxdiff
+
+#endif  // BASE_SBXDIFF_OBSERVABLE_CLOCK_H_
