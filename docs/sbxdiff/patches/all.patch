+    const span<const uint8_t> bytes = as_byte_span(material);
+    std::array<uint8_t, 32> derived = {};
+    SHA256(bytes.data(), bytes.size(), derived.data());
+    return derived;
+  };
+  static const std::optional<std::array<uint8_t, 32>> per_process = derive(true);
+  static const std::optional<std::array<uint8_t, 32>> shared = derive(false);
+  const auto& key = with_process_identity ? per_process : shared;
+  if (!key.has_value()) {
+    return false;
+  }
+  *out = key.value();
