+void WorkerThreadScheduler::MaybeJoinSbxdiffVirtualTime() {
+  // sbxdiff: coordinated virtual time across the page and this worker.
+  //
+  // ProcessTimeOverrideCoordinator already does the hard part -- it advances
+  // the process clock only to the minimum requested by any participating
+  // client -- but a worker never registers as one, so the page's clock and the
+  // worker's real clock run independently. For a sandbox whose page load is
+  // *served by* a worker that is fatal: with kDeterministicLoading the page
+  // pauses virtual time waiting for a load the worker has not produced yet, and
+  // the worker is not on the same clock to make progress against.
+  //
+  // Joining is lazy and one-way. It must not happen before the page has started
+  // virtual time: the coordinator's first client fixes the clock origin, and a
+  // worker that registered during its own startup would put the whole process
+  // on virtual time during bootstrap -- which is what broke service-worker
+  // registration in the first place.
+  if (!sbxdiff::VirtualTimeHasStarted() || IsVirtualTimeEnabled()) {
+    return;
+  }
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd || !cmd->HasSwitch(::switches::kSbxdiffInitialTime)) {
+    return;
+  }
+  // base::Time() deliberately: the null-time fallback in
+  // ThreadSchedulerBase::EnableVirtualTime reads --sbxdiff-initial-time, so the
+  // switch stays the single source of truth for both clocks. The coordinator
+  // ignores a second client's requested origin anyway.
+  // Logged because "the worker joined" and "the worker never got a task after
+  // the latch flipped, so never joined" are otherwise indistinguishable from
+  // the outside -- both just look like a hung run (RULES.md #26).
