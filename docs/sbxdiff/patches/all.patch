+    // clock, and then `Time::Now()` runs at real speed from the new origin.
+    // `TimeNowIgnoringOverride` on both sides of the arithmetic so this
+    // composes with, rather than fights, any other override.
+    if (sbx_cmd && sbx_cmd->HasSwitch(::switches::kSbxdiffTimeOffset)) {
+      int64_t origin_ms = 0;
+      if (base::StringToInt64(
+              sbx_cmd->GetSwitchValueASCII(::switches::kSbxdiffTimeOffset),
+              &origin_ms)) {
+        static base::TimeDelta g_sbxdiff_time_delta =
+            (base::Time::UnixEpoch() + base::Milliseconds(origin_ms)) -
+            base::subtle::TimeNowIgnoringOverride();
+        // NoDestructor: the override must outlive every thread that reads
+        // the clock, and tearing it down at exit would be both pointless and
+        // a -Wexit-time-destructors error.
+        static base::NoDestructor<base::subtle::ScopedTimeClockOverrides>
+            g_sbxdiff_clock(
+                []() {
+                  return base::subtle::TimeNowIgnoringOverride() +
+                         g_sbxdiff_time_delta;
+                },
+                nullptr, nullptr);
+        // sbxdiff: and publish the same origin to the LOGICAL clock.
+        //
+        // Only here, which means only on the side that has no virtual time --
+        // --sbxdiff-time-offset and --sbxdiff-initial-time are mutually
+        // exclusive in the harness. That is the point: the oracle gets its
+        // progression from virtual time, and this gives the sandbox the same
+        // progression without fencing the scheduler, which is the part the
+        // sandbox cannot survive (RULES.md #81).
+        //
+        // Inert unless SBXDIFF_LOGICAL_CLOCK is set.
+        base::sbxdiff::SetLogicalClockOrigin(base::Time::UnixEpoch() +
+                                             base::Milliseconds(origin_ms));
