+// Mirror of the harness's `bodyFileStem` (runway/src/sbxdiff/store.ts), so the
+// oracle's bytes land beside the sandbox's under the same name and a divergence
+// can be BYTE-DIFFED rather than just counted. The two sides share no object --
+// one is C++ in the network service, the other is JavaScript in the guest --
+// only this derivation, so it has to stay in step on both.
+std::string BodyFileStem(const std::string& url, int ordinal) {
+  std::string key = url + "#" + base::NumberToString(ordinal);
+  std::string out;
+  bool in_run = false;
+  for (char c : key) {
+    const bool safe = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+                      (c >= '0' && c <= '9') || c == '.' || c == '_' ||
+                      c == '-';
+    if (safe) {
+      out.push_back(c);
+      in_run = false;
+    } else if (!in_run) {
+      out.push_back('_');
+      in_run = true;
+    }
+  }
+  if (out.size() > 120) {
+    out = out.substr(out.size() - 120);
+  }
+  return out;
+}
+
+// Where to drop them, or nowhere. An env var rather than a switch because this
+// is a diagnostic the harness turns on for one run, and a switch would have to
+// be threaded through the renderer allowlist for no benefit.
+const base::FilePath& BodyDumpDir() {
+  static const base::NoDestructor<base::FilePath> dir([] {
+    std::optional<std::string> v =
+        base::Environment::Create()->GetVar("SBXDIFF_BODY_DUMP_DIR");
+    if (v && !v->empty()) {
+      return base::FilePath(*v);
+    }
+    return base::FilePath();
+  }());
+  return *dir;
+}
