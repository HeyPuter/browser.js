@@ -0,0 +1,181 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/sbxdiff_observable_clock.h"
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <cstdlib>
+#include <map>
+#include <string_view>
+
+namespace base::sbxdiff {
+
+namespace {
+
+std::atomic<int64_t> g_logical_origin_us{0};
+
+// Process-local fallback, used when no shared file was asked for.
+std::atomic<int64_t> g_logical_elapsed_us{0};
+
+bool LogicalClockRequested() {
+  static const bool on = [] {
+    const char* v = ::getenv("SBXDIFF_LOGICAL_CLOCK");
+    return v && *v && *v != '0';
+  }();
+  return on;
+}
+
+// The elapsed counter, shared by every process in the run when
+// SBXDIFF_LOGICAL_CLOCK_FILE names one.
+//
+// A browser has ONE clock, and the logical clock has to be one as well or it
+// is not a clock, it is a per-renderer stopwatch. Measured on rym: the oracle
+// put the page, the Turnstile widget and brunhild.challenges.cloudflare.com in
+// separate renderers, each counting from zero, while the sandbox -- where a
+// proxy has collapsed every origin onto its own -- ran all of them in one and
+// counted all of their timers. By the time the page minted the `ts` field of
+// its /httprequest/SecChk body, the two sides were 7200 ms apart, and that
+// 7200 ms was the entire difference between two otherwise byte-identical
+// request bodies (RULES.md #102, #103).
+//
+// A file rather than shared memory because it needs no handle plumbing through
+// every process launch, and every process in a run is on one machine and
+// already runs with --no-sandbox. MAP_SHARED makes the mapping coherent, and
+// the counter is a lock-free atomic, so a fetch/compare-exchange from two
+// renderers is as safe as from two threads.
+//
+// Falls back to the process-local counter if anything goes wrong, which is the
+// old behaviour rather than a crash: a clock that is wrong across processes
+// still lets a run finish and be read.
+std::atomic<int64_t>* SharedElapsed() {
+  static std::atomic<int64_t>* shared = []() -> std::atomic<int64_t>* {
+    const char* path = ::getenv("SBXDIFF_LOGICAL_CLOCK_FILE");
+    if (!path || !*path) {
+      return nullptr;
+    }
+    const int fd = ::open(path, O_RDWR | O_CREAT, 0600);
+    if (fd < 0) {
+      return nullptr;
+    }
+    // Every process does this; ftruncate to the same size is idempotent and
+    // never shrinks a file that is already right, so there is no race where
+    // one process zeroes the counter another has advanced.
+    struct stat st = {};
+    if (::fstat(fd, &st) != 0 ||
+        (st.st_size < static_cast<off_t>(sizeof(int64_t)) &&
+         ::ftruncate(fd, sizeof(int64_t)) != 0)) {
+      ::close(fd);
+      return nullptr;
+    }
+    void* map = ::mmap(nullptr, sizeof(int64_t), PROT_READ | PROT_WRITE,
+                       MAP_SHARED, fd, 0);
+    // The mapping outlives the descriptor.
+    ::close(fd);
+    if (map == MAP_FAILED) {
+      return nullptr;
+    }
+    static_assert(std::atomic<int64_t>::is_always_lock_free,
+                  "a shared counter cannot carry a lock");
+    return reinterpret_cast<std::atomic<int64_t>*>(map);
+  }();
+  return shared;
+}
+
+std::atomic<int64_t>& Elapsed() {
+  std::atomic<int64_t>* shared = SharedElapsed();
+  return shared ? *shared : g_logical_elapsed_us;
+}
+
+LogicalRealmResolver g_realm_resolver = nullptr;
+
+// Per-realm elapsed, for SBXDIFF_REALM_CLOCK. Thread-local because a realm
+// lives on one thread, so this needs no lock and no sharing across processes:
+// a realm does not span either.
+//
+// Leaked, like the tracer's caches: base builds with -Wexit-time-destructors.
+std::map<uint64_t, int64_t>& RealmElapsed() {
+  static thread_local std::map<uint64_t, int64_t>* per_realm =
+      new std::map<uint64_t, int64_t>();
+  return *per_realm;
+}
+
+uint64_t CurrentRealm() {
+  return g_realm_resolver ? g_realm_resolver() : 0;
+}
+
+}  // namespace
+
+void SetLogicalClockOrigin(Time origin) {
+  if (!LogicalClockRequested()) {
+    return;
+  }
+  g_logical_origin_us.store(
+      origin.is_null() ? 0 : (origin - Time::UnixEpoch()).InMicroseconds(),
+      std::memory_order_relaxed);
+}
+
+bool LogicalClockEnabled() {
+  return LogicalClockRequested() &&
+         g_logical_origin_us.load(std::memory_order_relaxed) != 0;
+}
+
+bool RealmClockEnabled() {
+  static const bool on = [] {
+    const char* v = ::getenv("SBXDIFF_REALM_CLOCK");
+    return v && *v && *v != '0';
+  }();
+  return on;
+}
+
+void SetLogicalRealmResolver(LogicalRealmResolver resolver) {
+  g_realm_resolver = resolver;
+}
+
+TimeDelta LogicalElapsed() {
+  if (RealmClockEnabled()) {
+    const auto& per_realm = RealmElapsed();
+    const auto it = per_realm.find(CurrentRealm());
+    return Microseconds(it == per_realm.end() ? 0 : it->second);
+  }
+  return Microseconds(Elapsed().load(std::memory_order_relaxed));
+}
+
+void AdvanceLogicalTo(TimeDelta due) {
+  if (!LogicalClockEnabled()) {
+    return;
+  }
+  const int64_t want = due.InMicroseconds();
+  if (RealmClockEnabled()) {
+    int64_t& seen = RealmElapsed()[CurrentRealm()];
+    // Never backwards, same as the shared path.
+    if (want > seen) {
+      seen = want;
+    }
+    return;
+  }
+  std::atomic<int64_t>& elapsed = Elapsed();
+  int64_t seen = elapsed.load(std::memory_order_relaxed);
+  // Never backwards: a timer that fires late must not rewind the clock for
+  // everything scheduled after it -- and with the counter shared across
+  // processes, not for another renderer either.
+  while (want > seen && !elapsed.compare_exchange_weak(
+                            seen, want, std::memory_order_relaxed)) {
+  }
+}
+
+Time LogicalNow(Time t) {
+  if (!LogicalClockEnabled()) {
+    return t;
+  }
+  return Time::UnixEpoch() +
+         Microseconds(g_logical_origin_us.load(std::memory_order_relaxed)) +
+         LogicalElapsed();
+}
+
+}  // namespace base::sbxdiff
