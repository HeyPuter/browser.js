+                // Before the start realm: leave the clock alone entirely, so
+                // the sandbox's own bootstrap runs on the real clock.
+                //
+                // A flag rather than an early return, so anything added to
+                // this function later still runs.
+                arm_budget = false;
+              }
+              // After the start realm, every realm re-arms: under kAdvance the
+              // clock only moves while budget remains, and the page load is
+              // serviced by a worker that needs it to keep moving.
